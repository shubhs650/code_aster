def analy_sixx(t):
    t = np.array(t)
    return (
        -9046996.20100002
        + 5551448.86556149 * np.exp(-1.37255183236978 * t)
        - 19341945.880022 * np.exp(-0.223200378543825 * t)
        + 10774831.6189123 * np.exp(-0.00928482612343169 * t)
    )


