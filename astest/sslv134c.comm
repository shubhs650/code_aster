# MODELISATION C : MODELE AXISYMETRIQUE, DEMI-PLAQUE

import math

DEBUT(CODE="OUI", ERREUR=_F(ALARME="EXCEPTION"), DEBUG=_F(SDVERI="OUI"))

# ----------------------------------------------------------------------
# DONNEES
# ----------------------------------------------------------------------

# chargement
sig = 1.0e6

# rayon de la fissure
a = 2

# coefficients élastiques
E = 200000.0e6
nu = 0.3

# ----------------------------------------------------------------------
# Calcul mécanique en élasticité linéaire
# ----------------------------------------------------------------------

MA = LIRE_MAILLAGE(VERI_MAIL=_F(VERIF="OUI"), FORMAT="MED")

MA = MODI_MAILLAGE(reuse=MA, MAILLAGE=MA, ORIE_PEAU_2D=_F(GROUP_MA="LEV_SUP"))

MA = MODI_MAILLAGE(
    reuse=MA, MAILLAGE=MA, MODI_MAILLE=_F(OPTION="NOEUD_QUART", GROUP_NO_FOND="FRONT")
)

MO = AFFE_MODELE(MAILLAGE=MA, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="AXIS"))

MAT = DEFI_MATERIAU(ELAS=_F(E=E, NU=nu, ALPHA=0.0, RHO=7850))

CHMAT = AFFE_MATERIAU(MAILLAGE=MA, AFFE=_F(TOUT="OUI", MATER=MAT))

CH_BLOC = AFFE_CHAR_MECA(
    MODELE=MO, DDL_IMPO=(_F(GROUP_MA="GAUCHE", DX=0.0), _F(GROUP_MA="LIG", DY=0.0))
)

CHAR = AFFE_CHAR_MECA(MODELE=MO, FORCE_CONTOUR=_F(GROUP_MA="HAUT", FY=sig))

RESU = MECA_STATIQUE(MODELE=MO, CHAM_MATER=CHMAT, EXCIT=(_F(CHARGE=CHAR), _F(CHARGE=CH_BLOC)))

# ----------------------------------------------------------------------
# Post-traitements
# ----------------------------------------------------------------------

IMPR_RESU(FORMAT="MED", UNITE=80, RESU=_F(RESULTAT=RESU))

FISS = DEFI_FOND_FISS(
    MAILLAGE=MA, SYME="OUI", FOND_FISS=_F(GROUP_NO="FRONT"), LEVRE_SUP=_F(GROUP_MA="LEV_SUP")
)

TABL_G = CALC_G(
    OPTION=("G", "K", "KJ"), RESULTAT=RESU, THETA=_F(NB_COUCHE_INF=2, NB_COUCHE_SUP=5, FISSURE=FISS)
)

IMPR_TABLE(TABLE=TABL_G)

# POST_K1_K2_K3
TABL_K = POST_K1_K2_K3(RESULTAT=RESU, FOND_FISS=FISS)

IMPR_TABLE(TABLE=TABL_K)

# ----------------------------------------------------------------------
# Tests sur les tables
# ----------------------------------------------------------------------

# VALEURS DE REFERENCE MILIEU INFINI
KIref = 2 * sig * math.sqrt(a / math.pi)
Gref = (1 - nu**2) / E * KIref**2

print("KIref ", KIref)
print("Gref ", Gref)

# Erreurs
KI = TABL_G.EXTR_TABLE().values()["K1"][0]
KJ = TABL_G.EXTR_TABLE().values()["KJ"][0]
G = TABL_G.EXTR_TABLE().values()["G"][0]
KI_pk = TABL_K.EXTR_TABLE().values()["K1"][0]

print("CALC_G - Erreur sur KI : {:.2f}%".format((KI - KIref) / KIref * 100))
print("CALC_G - Erreur sur KJ : {:.2f}%".format((KJ - KIref) / KIref * 100))
print("CALC_G - Erreur sur G : {:.2f}%".format((G - Gref) / Gref * 100))
print("POST_K1_K2_K3 - Erreur sur KI : {:.2f}%".format((KI_pk - KIref) / KIref * 100))

# Tolérances pour les TEST_TABLE
tol_G = 1.8e-2
tol_K = tol_G / 2

# Rq : tant que les termes de courbures ne sont pas dispo en axi, on a une erreur sur le KI de CALC_G
# importante, sans lien avec l'erreur sur G : glute temporaire d'une autre tolérance qu'il faudra virer
# une fois l'issue35866 restituée
tol_K_tmp = 0.03  # tolérance temporaire

# TESTS SUR LA TABLE ISSUE de CALC_G
TEST_TABLE(
    TABLE=TABL_G,
    NOM_PARA="K1",
    VALE_REFE=KIref,
    REFERENCE="ANALYTIQUE",
    PRECISION=tol_K_tmp,
    # ~PRECISION=tol_K,
    VALE_CALC=1641232.9643824485,
)

TEST_TABLE(
    TABLE=TABL_G,
    NOM_PARA="KJ",
    VALE_REFE=KIref,
    REFERENCE="ANALYTIQUE",
    PRECISION=tol_K,
    VALE_CALC=1609406.7649831565,
)

TEST_TABLE(
    TABLE=TABL_G,
    NOM_PARA="G",
    VALE_REFE=Gref,
    REFERENCE="ANALYTIQUE",
    PRECISION=tol_G,
    VALE_CALC=11.785365115039653,
)

# TESTS SUR LA TABLE ISSUE de POST_K1_K2_K3
TEST_TABLE(
    TABLE=TABL_K,
    NOM_PARA="K1",
    VALE_REFE=KIref,
    REFERENCE="ANALYTIQUE",
    PRECISION=tol_K,
    VALE_CALC=1609690.6998059307,
)

TEST_TABLE(
    TABLE=TABL_K,
    NOM_PARA="G",
    VALE_REFE=Gref,
    REFERENCE="ANALYTIQUE",
    PRECISION=tol_G,
    VALE_CALC=11.789523878139766,
)


# ----------------------------------------------------------------------
#           CHARGEMENT VIA PRESSION AUX LEVRES
# ----------------------------------------------------------------------

CHAR_PRES = AFFE_CHAR_MECA(MODELE=MO, PRES_REP=_F(GROUP_MA="LEV_SUP", PRES=sig))

RESU_PRES = MECA_STATIQUE(
    MODELE=MO, CHAM_MATER=CHMAT, EXCIT=(_F(CHARGE=CHAR_PRES), _F(CHARGE=CH_BLOC))
)


TABL_G_PRES = CALC_G(
    OPTION=("G", "K", "KJ"),
    RESULTAT=RESU_PRES,
    THETA=_F(NB_COUCHE_INF=2, NB_COUCHE_SUP=5, FISSURE=FISS),
)

IMPR_TABLE(TABLE=TABL_G_PRES)

TEST_TABLE(
    TABLE=TABL_G_PRES,
    NOM_PARA="K1",
    VALE_REFE=KIref,
    REFERENCE="ANALYTIQUE",
    PRECISION=tol_K_tmp,
    # ~PRECISION=tol_K,
    VALE_CALC=1640140.877461735,
)

TEST_TABLE(
    TABLE=TABL_G_PRES,
    NOM_PARA="KJ",
    VALE_REFE=KIref,
    REFERENCE="ANALYTIQUE",
    PRECISION=tol_K,
    VALE_CALC=1609406.76498316,
)

TEST_TABLE(
    TABLE=TABL_G_PRES,
    NOM_PARA="G",
    VALE_REFE=Gref,
    REFERENCE="ANALYTIQUE",
    PRECISION=tol_G,
    VALE_CALC=11.785365115039696,
)


FIN()
#
