# CAS TEST  SSNP501A
# MODELE   : METHODE DES CONTRAINTES ACTIVES
# MAILLAGE : QUA4
#
# UNITES   : NEWTON , CENTIMETRE , SECONDE (N,CM,S)
#
from code_aster.MacroCommands.defi_cont import DEFI_CONT

DEBUT(CODE="OUI", DEBUG=_F(SDVERI="OUI"))

E_p = 407
Nu_p = 0.48
E_a = 2.07e7
Nu_a = 0.3
coef = E_p * 10

MA = LIRE_MAILLAGE(FORMAT="MED")

MA = DEFI_GROUP(
    reuse=MA,
    MAILLAGE=MA,
    CREA_GROUP_NO=(
        _F(TOUT_GROUP_MA="OUI"),
        _F(OPTION="NOEUD_ORDO", NOM="LRESU", GROUP_MA="LESC", GROUP_NO_ORIG="A", GROUP_NO_EXTR="D"),
    ),
)

# ----- GRANDEUR PHYSIQUE ------

POLTH = DEFI_MATERIAU(ELAS=_F(E=E_p, NU=Nu_p), ECRO_LINE=_F(D_SIGM_EPSI=1.0, SY=1e15))

ACIER = DEFI_MATERIAU(ELAS=_F(E=E_a, NU=Nu_a), ECRO_LINE=_F(D_SIGM_EPSI=1.0, SY=1e15))

# -----   MODELE ----------------

MO = AFFE_MODELE(
    MAILLAGE=MA,
    AFFE=_F(GROUP_MA=("ANNEAU", "PLAQUE"), PHENOMENE="MECANIQUE", MODELISATION="C_PLAN"),
)

MA = MODI_MAILLAGE(reuse=MA, MAILLAGE=MA, ORIE_PEAU=_F(GROUP_MA_PEAU=("LMAI", "LESC")), INFO=2)


CHMAT = AFFE_MATERIAU(
    MAILLAGE=MA, AFFE=(_F(GROUP_MA="PLAQUE", MATER=ACIER), _F(GROUP_MA="ANNEAU", MATER=POLTH))
)

# ------ CONDITIONS AUX LIMITES -----------------

CL = AFFE_CHAR_MECA(
    MODELE=MO,
    DDL_IMPO=(
        _F(GROUP_NO="PLAQUE", DX=0.0),
        _F(GROUP_NO="LCD", DY=0.0),
        _F(GROUP_NO="LAB", DX=0.0),
    ),  # LIAISON_DDL=_F(GROUP_NO=("A", "P1"), DDL=("DY", "DY"), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0),
)

DEPL = AFFE_CHAR_MECA(MODELE=MO, DDL_IMPO=_F(GROUP_NO="PLAQUE", DY=-2.225))


CON = DEFI_CONT(
    MODELE=MO,
    INFO=1,
    ZONE=(
        _F(
            GROUP_MA_MAIT="LMAI",
            GROUP_MA_ESCL="LESC",
            ALGO_CONT="PENALISATION",
            COEF_CONT=coef,
            CONTACT_INIT="OUI",
            AIRE_TOLE=1e-15,
            TYPE_APPA="FORCEBRUTE",
            TYPE_INTE="SEG_BASE",
            FROTTEMENT="NON",
        ),
    ),
)

# --------- DEFINITION DES FONCTIONS -----------------

RAMPE = DEFI_FONCTION(NOM_PARA="INST", VALE=(0.0, 0.0, 4.0, 1.0), INTERPOL="LIN")

LINST = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=4.0, NOMBRE=16))

# -------- CALCUL STATIQUE --------------------------

RESU = MECA_NON_LINE(
    MODELE=MO,
    CHAM_MATER=CHMAT,
    EXCIT=(_F(CHARGE=CL), _F(CHARGE=DEPL, FONC_MULT=RAMPE)),
    CONTACT=_F(DEFINITION=CON, ALGO_RESO_GEOM="NEWTON"),
    NEWTON=_F(MATRICE="TANGENTE", REAC_ITER=1),
    COMPORTEMENT=_F(RELATION="VMIS_ISOT_LINE", DEFORMATION="GDEF_LOG"),
    INCREMENT=_F(LIST_INST=LINST),
    CONVERGENCE=_F(RESI_GLOB_RELA=1.0e-6, ITER_GLOB_MAXI=50),
    INFO=1,
)

# ------- POST TRAITEMENT -----------------------

RESU = CALC_CHAMP(reuse=RESU, CONTRAINTE=("SIGM_ELNO"), RESULTAT=RESU)

RESU = CALC_CHAMP(reuse=RESU, RESULTAT=RESU, FORCE="REAC_NODA", CONTRAINTE="SIGM_NOEU")

TAB_REAC = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="MESSAGE",
        GROUP_NO="LRESU",
        RESULTAT=RESU,
        NOM_CHAM="REAC_NODA",
        RESULTANTE="DY",
        OPERATION="EXTRACTION",
    )
)


TAB_PRES = POST_RELEVE_T(
    ACTION=_F(
        INTITULE="MESSAGE",
        GROUP_NO="LRESU",
        RESULTAT=RESU,
        NOM_CHAM="SIGM_NOEU",
        INST=4.0,
        NOM_CMP=("SIYY", "SIXY"),
        OPERATION="EXTRACTION",
    )
)


# ------- TEST DES RESULTATS --------------
# TEST REFERENCE

TEST_TABLE(
    REFERENCE="SOURCE_EXTERNE",
    PRECISION=0.078,
    VALE_CALC=-8.619663090020985,
    VALE_REFE=-8.0083311249999998,
    NOM_PARA="DY",
    TABLE=TAB_REAC,
    FILTRE=_F(NOM_PARA="INST", VALE=1.0),
)

TEST_TABLE(
    REFERENCE="SOURCE_EXTERNE",
    PRECISION=0.018,
    VALE_CALC=-16.289329625940216,
    VALE_REFE=-16.016662499999999,
    NOM_PARA="DY",
    TABLE=TAB_REAC,
    FILTRE=_F(NOM_PARA="INST", VALE=2.0),
)

TEST_TABLE(
    REFERENCE="SOURCE_EXTERNE",
    PRECISION=0.013,
    VALE_CALC=-23.72601910164866,
    VALE_REFE=-24.02499375,
    NOM_PARA="DY",
    TABLE=TAB_REAC,
    FILTRE=_F(NOM_PARA="INST", VALE=3.0),
)

TEST_TABLE(
    REFERENCE="SOURCE_EXTERNE",
    PRECISION=0.019,
    VALE_CALC=-32.614824173735435,
    VALE_REFE=-32.033324999999998,
    NOM_PARA="DY",
    TABLE=TAB_REAC,
    FILTRE=_F(NOM_PARA="INST", VALE=4.0),
)

# TEST NON REGRESSION
TEST_RESU(
    RESU=_F(
        GROUP_NO="D",
        INST=2.0,
        RESULTAT=RESU,
        NOM_CHAM="DEPL",
        NOM_CMP="DX",
        VALE_CALC=0.7635489478964312,
    )
)

TEST_RESU(
    RESU=_F(
        GROUP_NO="D",
        INST=4.0,
        RESULTAT=RESU,
        NOM_CHAM="DEPL",
        NOM_CMP="DX",
        VALE_CALC=1.4074788040074675,
    )
)

TEST_RESU(
    RESU=_F(
        GROUP_NO="A",
        INST=2.0,
        RESULTAT=RESU,
        NOM_CHAM="SIGM_NOEU",
        NOM_CMP="SIYY",
        VALE_CALC=-19.544979031724978,
    )
)

TEST_RESU(
    RESU=_F(
        GROUP_NO="A",
        INST=4.0,
        RESULTAT=RESU,
        NOM_CHAM="SIGM_NOEU",
        NOM_CMP="SIYY",
        VALE_CALC=-13.118430758367442,
    )
)

FIN()
