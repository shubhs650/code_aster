#
#
# --------------------------------------------------------------------------------------------------
#
#                   LOI BETON_RAG
#
#   Vérification du comportement mécanique avec endommagement + puis fluage
#
# 4 : compression / Epsi  1d / Sigma diagonal / Déplacement imposé
#
# --------------------------------------------------------------------------------------------------
DEBUT(CODE="OUI")
#
# !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !!
#
#   NE PAS UTILISER LES CARACTÉRISTIQUES MATÉRIAUX DE "BETON_RAG"
#   DE CE CAS TEST POUR FAIRE DES ÉTUDES.
#
#   ILS NE SONT PAS PHYSIQUES, ILS SERVENT À DE LA VÉRIFICATION MATHÉMATIQUE
#
# !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !!
#
import numpy as np
from numpy import exp


def sigz(t):
    return (
        -11857879.8566809 * exp(-1.60188549946807 * t)
        - 17479139.4295991 * exp(-1.05183074168425 * t)
        + 0.00274527072906494 * exp(-0.5 * t)
        - 1.52736902236938e-5 * exp(-0.2 * t)
        - 5208755.6050686 * exp(-0.0159811671985924 * t)
        - 3854192.81823797 * exp(-0.0121692583157476 * t)
    )


def sigx(t):
    return (
        5928959.15021706 * exp(-1.60188549946807 * t)
        - 17479140.3818688 * exp(-1.05183074168425 * t)
        + 0.000632047653198242 * exp(-0.5 * t)
        + 7.62939453125e-6 * exp(-0.2 * t)
        + 2604377.8025343 * exp(-0.0159811671985924 * t)
        - 3854192.81823794 * exp(-0.0121692583157476 * t)
    )


# Paramètres matériau
# /!\ Ne pas utiliser ces paramètres dans des études, ils ne sont pas physiques, et servent uniquement à de la vérification mathématique
E = 32000.0e06
nu = 0.25
k_r_sph = 1.6e10  # k_r_sph est augmenté par rapport aux autres cas-tests pour éviter des contraintes positives en X et Y à cause du fluage et blocage en X/Y
eta_r_sph = 8.0e10
eta_i_sph = 1.0e12
k_r_dev = 1.2e10
eta_r_dev = 2.4e10
eta_i_dev = 5.0e11
kappa_i = 0.0

# Déplacement imposé
dz = -1.0e-3

# Paramètres temporels
Tmeca = 1.0
NbPasMeca = 5
Tflua = 34.0
NbPasFlua = 340

# Paramètres de convergence
ResiGlob = 1.0e-09
ResiInteRela = 1.0e-07

# Début étude Aster
MAIL = LIRE_MAILLAGE(FORMAT="ASTER")

MOMECA = AFFE_MODELE(MAILLAGE=MAIL, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"))

MATMECA = DEFI_MATERIAU(
    ELAS=_F(E=E, NU=nu),
    BETON_RAG=_F(
        COMP_BETON="ENDO",
        ENDO_MC=1.95,
        ENDO_MT=2.00,
        ENDO_SIGUC=-35.00e06,
        ENDO_SIGUT=-3.18e06,
        ENDO_DRUPRA=0.15,
    ),
)

MATFLUA_BRAG = DEFI_MATERIAU(
    ELAS=_F(E=E, NU=nu),
    BETON_RAG=_F(
        COMP_BETON="ENDO_FLUA",
        # unités : Pa
        ENDO_MC=1.95,
        ENDO_MT=2.00,
        ENDO_SIGUC=-35.00e06,
        ENDO_SIGUT=-3.18e06,
        ENDO_DRUPRA=0.15,
        # Unités : Pa Jour
        FLUA_SPH_KR=k_r_sph,
        FLUA_SPH_NR=eta_r_sph,
        FLUA_SPH_NI=eta_i_sph,
        FLUA_DEV_KR=k_r_dev,
        FLUA_DEV_NR=eta_r_dev,
        FLUA_DEV_NI=eta_i_dev,
    ),
)

FONC1 = DEFI_FONCTION(
    NOM_PARA="SECH", PROL_DROITE="LINEAIRE", PROL_GAUCHE="LINEAIRE", VALE=(0.0, 0.0, 1.0, 1.0)
)

MATFLUA_BBUR = DEFI_MATERIAU(
    ELAS_FO=_F(
        E=DEFI_CONSTANTE(VALE=E),
        NU=DEFI_CONSTANTE(VALE=nu),
        TEMP_DEF_ALPHA=0.0,
        ALPHA=DEFI_CONSTANTE(VALE=0.0),
    ),
    BETON_DESORP=_F(FONC_DESORP=FONC1),
    BETON_BURGER=_F(
        YoungModulus=E,
        PoissonRatio=nu,
        K_RS=k_r_sph,
        ETA_RS=eta_r_sph,
        ETA_IS=eta_i_sph,
        K_RD=k_r_dev,
        ETA_RD=eta_r_dev,
        ETA_ID=eta_i_dev,
        KAPPA=5e14,
        QSR_K=0.0,
        ETA_FD=0.0,
        TEMP_0_C=20.0,
    ),
)
TEMP = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="NOEU_TEMP_R",
    MAILLAGE=MAIL,
    AFFE=_F(TOUT="OUI", NOM_CMP="TEMP", VALE=20.0),
)

SECH = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="NOEU_TEMP_R",
    MAILLAGE=MAIL,
    AFFE=_F(TOUT="OUI", NOM_CMP="SECH", VALE=1.0),
)

CHMATM = AFFE_MATERIAU(MAILLAGE=MAIL, AFFE=_F(TOUT="OUI", MATER=MATMECA))

CHMATF_BRAG = AFFE_MATERIAU(MAILLAGE=MAIL, AFFE=_F(TOUT="OUI", MATER=MATFLUA_BRAG))
CHMATF_BBUR = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=_F(TOUT="OUI", MATER=MATFLUA_BBUR),
    AFFE_VARC=(
        _F(TOUT="OUI", CHAM_GD=SECH, NOM_VARC="SECH", VALE_REF=1),
        _F(TOUT="OUI", CHAM_GD=TEMP, NOM_VARC="TEMP", VALE_REF=20),
    ),
    MODELE=MOMECA,
)

CLMECA = AFFE_CHAR_MECA(
    MODELE=MOMECA,
    DDL_IMPO=(
        _F(GROUP_MA="BAS", DZ=0.0),
        _F(GROUP_MA="COTEG", DY=0.0),
        _F(GROUP_MA="COTED", DY=0.0),
        _F(GROUP_MA="ARRIERE", DX=0.0),
        _F(GROUP_MA="AVANT", DX=0.0),
    ),
)

# Impose un déplacement
CHMECA = AFFE_CHAR_MECA(MODELE=MOMECA, DDL_IMPO=_F(GROUP_MA="HAUT", DZ=dz))
FCT = DEFI_FONCTION(NOM_PARA="INST", VALE=(0.0, 0.0, Tmeca, 1.0, 1000.0, 1.0))

L_INST = DEFI_LIST_REEL(
    DEBUT=0.0,
    INTERVALLE=(_F(JUSQU_A=Tmeca, NOMBRE=NbPasMeca), _F(JUSQU_A=Tmeca + Tflua, NOMBRE=NbPasFlua)),
)
L_INST_BBUR = DEFI_LIST_REEL(
    DEBUT=0.0,
    INTERVALLE=(
        _F(JUSQU_A=Tmeca, NOMBRE=NbPasMeca),
        _F(JUSQU_A=Tmeca + Tflua, NOMBRE=NbPasFlua * 8),
    ),
)

# La partie mécanique sans fluage pour stabilisation
RESU = STAT_NON_LINE(
    MODELE=MOMECA,
    CHAM_MATER=CHMATM,
    EXCIT=(_F(CHARGE=CLMECA), _F(CHARGE=CHMECA, FONC_MULT=FCT)),
    COMPORTEMENT=_F(RELATION="BETON_RAG"),
    INCREMENT=_F(LIST_INST=L_INST, INST_FIN=Tmeca),
    NEWTON=_F(MATRICE="TANGENTE", REAC_ITER=1),
    CONVERGENCE=_F(RESI_GLOB_RELA=ResiGlob, ITER_GLOB_MAXI=20),
)

# Préparation pour fluage Bürger (MFRONT)
CHSIG = CREA_CHAMP(
    TYPE_CHAM="ELGA_SIEF_R", OPERATION="EXTR", RESULTAT=RESU, NOM_CHAM="SIEF_ELGA", INST=Tmeca
)
CHDEP = CREA_CHAMP(
    TYPE_CHAM="NOEU_DEPL_R", OPERATION="EXTR", RESULTAT=RESU, NOM_CHAM="DEPL", INST=Tmeca
)
CHEPSI = CREA_CHAMP(
    TYPE_CHAM="ELGA_EPSI_R",
    OPERATION="EXTR",
    RESULTAT=CALC_CHAMP(RESULTAT=RESU, DEFORMATION=("EPSI_ELGA")),
    NOM_CHAM="EPSI_ELGA",
    INST=Tmeca,
)

CHVARI = CREA_CHAMP(
    OPERATION="ASSE",
    MODELE=MOMECA,
    TYPE_CHAM="ELGA_VARI_R",
    ASSE=_F(
        CHAM_GD=CHEPSI,
        TOUT="OUI",
        NOM_CMP=("EPXX", "EPYY", "EPZZ", "EPXY", "EPXZ", "EPYZ"),
        NOM_CMP_RESU=("V1", "V2", "V3", "V4", "V5", "V6"),
    ),
)
CHVARI2 = CREA_CHAMP(
    OPERATION="AFFE",
    MODELE=MOMECA,
    TYPE_CHAM="ELGA_VARI_R",
    PROL_ZERO="OUI",
    AFFE=(
        _F(
            TOUT="OUI",
            NOM_CMP=["V{}".format(i) for i in range(7, 35)],
            VALE=[0.0 for i in range(7, 35)],
        )
    ),
)
CHVARIF = CREA_CHAMP(
    OPERATION="ASSE",
    MODELE=MOMECA,
    TYPE_CHAM="ELGA_VARI_R",
    ASSE=(_F(TOUT="OUI", CHAM_GD=CHVARI2), _F(TOUT="OUI", CHAM_GD=CHVARI)),
)

# La partie fluage
RESUF_BRAG = STAT_NON_LINE(
    reuse=RESU,
    MODELE=MOMECA,
    CHAM_MATER=CHMATF_BRAG,
    ETAT_INIT=_F(EVOL_NOLI=RESU, INST=Tmeca),
    EXCIT=(_F(CHARGE=CLMECA), _F(CHARGE=CHMECA, FONC_MULT=FCT)),
    COMPORTEMENT=_F(RELATION="BETON_RAG", RESI_INTE=ResiInteRela),
    INCREMENT=_F(LIST_INST=L_INST, INST_FIN=Tmeca + Tflua),
    NEWTON=_F(MATRICE="TANGENTE", REAC_ITER=1),
    CONVERGENCE=_F(RESI_GLOB_RELA=ResiGlob, ITER_GLOB_MAXI=20),
)

# Calcul pour vérification avec modèle MFRONT
RESUF_BBUR = STAT_NON_LINE(
    MODELE=MOMECA,
    CHAM_MATER=CHMATF_BBUR,
    EXCIT=(_F(CHARGE=CLMECA), _F(CHARGE=CHMECA, FONC_MULT=FCT)),
    COMPORTEMENT=_F(RELATION="BETON_BURGER", RESI_INTE=1.0e-14, TOUT="OUI"),
    ETAT_INIT=_F(SIGM=CHSIG, DEPL=CHDEP, VARI=CHVARIF),
    INCREMENT=_F(LIST_INST=L_INST_BBUR, INST_INIT=Tmeca, INST_FIN=Tmeca + Tflua),
    NEWTON=_F(MATRICE="TANGENTE", REAC_ITER=1),
    CONVERGENCE=_F(RESI_GLOB_RELA=ResiGlob, ITER_GLOB_MAXI=20),
)

# Calcul des déformations
RESUF_BRAG = CALC_CHAMP(reuse=RESUF_BRAG, RESULTAT=RESUF_BRAG, DEFORMATION=("EPSI_ELGA"))
RESUF_BBUR = CALC_CHAMP(reuse=RESUF_BBUR, RESULTAT=RESUF_BBUR, DEFORMATION=("EPSI_ELGA"))

# Calcul des fonctions donnant contraintes et déformations
SIXX_BRAG = RECU_FONCTION(
    RESULTAT=RESUF_BRAG,
    NOM_CHAM="SIEF_ELGA",
    NOM_CMP="SIXX",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="SIXX",
)
SIYY_BRAG = RECU_FONCTION(
    RESULTAT=RESUF_BRAG,
    NOM_CHAM="SIEF_ELGA",
    NOM_CMP="SIYY",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="SIYY",
)
SIZZ_BRAG = RECU_FONCTION(
    RESULTAT=RESUF_BRAG,
    NOM_CHAM="SIEF_ELGA",
    NOM_CMP="SIZZ",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="SIZZ",
)
EPXX_BRAG = RECU_FONCTION(
    RESULTAT=RESUF_BRAG,
    NOM_CHAM="EPSI_ELGA",
    NOM_CMP="EPXX",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="EPXX",
)
EPYY_BRAG = RECU_FONCTION(
    RESULTAT=RESUF_BRAG,
    NOM_CHAM="EPSI_ELGA",
    NOM_CMP="EPYY",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="EPYY",
)
EPZZ_BRAG = RECU_FONCTION(
    RESULTAT=RESUF_BRAG,
    NOM_CHAM="EPSI_ELGA",
    NOM_CMP="EPZZ",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="EPZZ",
)

SIXX_BBUR = RECU_FONCTION(
    RESULTAT=RESUF_BBUR,
    NOM_CHAM="SIEF_ELGA",
    NOM_CMP="SIXX",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="SIXX",
)
SIYY_BBUR = RECU_FONCTION(
    RESULTAT=RESUF_BBUR,
    NOM_CHAM="SIEF_ELGA",
    NOM_CMP="SIYY",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="SIYY",
)
SIZZ_BBUR = RECU_FONCTION(
    RESULTAT=RESUF_BBUR,
    NOM_CHAM="SIEF_ELGA",
    NOM_CMP="SIZZ",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="SIZZ",
)
EPXX_BBUR = RECU_FONCTION(
    RESULTAT=RESUF_BBUR,
    NOM_CHAM="EPSI_ELGA",
    NOM_CMP="EPXX",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="EPXX",
)
EPYY_BBUR = RECU_FONCTION(
    RESULTAT=RESUF_BBUR,
    NOM_CHAM="EPSI_ELGA",
    NOM_CMP="EPYY",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="EPYY",
)
EPZZ_BBUR = RECU_FONCTION(
    RESULTAT=RESUF_BBUR,
    NOM_CHAM="EPSI_ELGA",
    NOM_CMP="EPZZ",
    GROUP_MA="G3D",
    POINT=8,
    NOM_RESU="EPZZ",
)

# Temps pour la vérification
t = np.linspace(0, 34, 35)

# Solutions analytiques
sig_z = sigz(t)
sig_x = sigx(t)

# Réponse précédente sizz BETON_RAG
val_sizz_BRAG_prec = [
    -38400000.0,
    -17428734.1996279843151569366455078125,
    -11420569.50049333088099956512451171875,
    -9522896.77508199214935302734375,
    -8837033.92762149311602115631103515625,
