#
#
# --------------------------------------------------------------------------------------------------
#
#                   LOI BETON_RAG
#
#   Vérification du comportement mécanique avec endommagement + puis fluage
#
# 2 : compression / Sigma 3d / Epsi  nul
#
# --------------------------------------------------------------------------------------------------
DEBUT(CODE="OUI", ERREUR=_F(ALARME="EXCEPTION"))
#
# !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !!
#
#   NE PAS UTILISER LES CARACTÉRISTIQUES MATÉRIAUX DE "BETON_RAG"
#   DE CE CAS TEST POUR FAIRE DES ÉTUDES.
#
#   ILS NE SONT PAS PHYSIQUES, ILS SERVENT À DE LA VÉRIFICATION MATHÉMATIQUE
#
# !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !! !!
#
import numpy as np


MAIL = LIRE_MAILLAGE(FORMAT="ASTER")

MOMECA = AFFE_MODELE(MAILLAGE=MAIL, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"))

MBETRAG = DEFI_MATERIAU(
    ELAS=_F(E=32000.0e06, NU=0.25, ALPHA=0.0),
    BETON_RAG=_F(
        COMP_BETON="ENDO_FLUA_RAG",
        # Endommagement
        ENDO_MC=1.95,
        ENDO_MT=2.00,
        ENDO_SIGUC=-35.00e06,  # [Pa] si < 0 plus d'endommagement
        ENDO_SIGUT=-3.18e06,  # [Pa] si < 0 plus d'endommagement
        ENDO_DRUPRA=0.15,
        # Fluage
        FLUA_SPH_KR=-89000.0e06,  # [Pa]   si NR et NI et KR < 0, arrêt du fluage
        FLUA_SPH_NR=-156000.0e06,  # [Pa.J] si NR et NI et KR < 0, arrêt du fluage
        FLUA_SPH_NI=-410000.0e06,  # [Pa.J] si NR et NI et KR < 0, arrêt du fluage
        FLUA_DEV_KR=-42000.0e06,  # [Pa]   si NR et NI et KR < 0, arrêt du fluage
        FLUA_DEV_NR=-117000.0e06,  # [Pa.J] si NR et NI et KR < 0, arrêt du fluage
        FLUA_DEV_NI=-840000.0e06,  # [Pa.J] si NR et NI et KR < 0, arrêt du fluage
        # Avancement de la RAG
        GEL_ALPHA0=1.0e-04,  # si 0 plus d'avancement
        GEL_TREF=25.0,  # [°C]
        GEL_EAR=45000.0,  # [1/°K]
        GEL_SR0=0.20,
        # Pression du Gel
        GEL_VG=3.0e-03,
        GEL_MG=26000.0e06,  # [Pa]
        GEL_BG=0.080,  # si 0 plus de pression
        GEL_A0=0.20,
        #
        RAG_EPSI0=0.0,  # si 0 plus de déformation visqueuse de RAG 3.0E-03
        # Pression capilaire
        PW_A=3.0e06,  # [Pa]  si 0 plus de pression
        PW_B=2.0,
    ),
)

# Liste commune pour l'évolution de la température et du séchage
L_evol = DEFI_LIST_REEL(VALE=(0.0, 2.0, 10.0, 40.0, 50.0, 80.0, 100.0, 110.0, 200.0))

# Champ de Température
TFONC = DEFI_FONCTION(
    NOM_PARA="INST",
    PROL_DROITE="CONSTANT",
    PROL_GAUCHE="CONSTANT",
    VALE=(0.0, 10.0, 2.0, 10.0, 10.0, 40.0, 40.0, 50.0, 100.0, 20.0, 200.0, 50.0),
)
TIMPO = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="NOEU_TEMP_F",
    MAILLAGE=MAIL,
    AFFE=_F(TOUT="OUI", NOM_CMP="TEMP", VALE_F=TFONC),
)
TEMPER = (
    CREA_RESU(
        OPERATION="AFFE",
        TYPE_RESU="EVOL_THER",
        AFFE=_F(NOM_CHAM="TEMP", CHAM_GD=TIMPO, LIST_INST=L_evol),
    ),
)

# Champ de Séchage
SFONC = DEFI_FONCTION(
    NOM_PARA="INST",
    PROL_DROITE="CONSTANT",
    PROL_GAUCHE="CONSTANT",
    VALE=(0.0, 0.30, 2.0, 0.30, 50.0, 0.60, 80.0, 0.30, 100.0, 0.70, 110.0, 0.70),
)
SIMPO = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="NOEU_TEMP_F",
    MAILLAGE=MAIL,
    AFFE=_F(TOUT="OUI", NOM_CMP="SECH", VALE_F=SFONC),
)
SECHAG = (
    CREA_RESU(
        OPERATION="AFFE",
        TYPE_RESU="EVOL_SECH",
        AFFE=_F(NOM_CHAM="SECH", CHAM_GD=SIMPO, LIST_INST=L_evol),
    ),
)


CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=_F(TOUT="OUI", MATER=MBETRAG),
    AFFE_VARC=(
        _F(TOUT="OUI", EVOL=TEMPER, NOM_VARC="TEMP", NOM_CHAM="TEMP", VALE_REF=0.0),
        _F(TOUT="OUI", EVOL=SECHAG, NOM_VARC="SECH", NOM_CHAM="SECH", VALE_REF=0.0),
    ),
)

# 'BAS', 'COTEG', 'COTED', 'ARRIERE', 'AVANT', 'HAUT'
CLMECA = AFFE_CHAR_MECA(
    MODELE=MOMECA,
    DDL_IMPO=(
        _F(GROUP_MA=("BAS", "HAUT"), DZ=0.0),
        _F(GROUP_MA=("COTEG", "COTED"), DY=0.0),
        _F(GROUP_MA=("ARRIERE", "AVANT"), DX=0.0),
    ),
)

ResiGlobRela = 1.0e-06
ResiInteRela = 1.0e-12

Tfin = 200.0
NbTfin = 100
L_INST = DEFI_LIST_REEL(
    DEBUT=0.0, INTERVALLE=(_F(JUSQU_A=2.0, NOMBRE=10), _F(JUSQU_A=Tfin, NOMBRE=99))
)

#
RESU = STAT_NON_LINE(
    MODELE=MOMECA,
    CHAM_MATER=CHMAT,
    EXCIT=(_F(CHARGE=CLMECA),),
    COMPORTEMENT=_F(RELATION="BETON_RAG"),
    INCREMENT=_F(LIST_INST=L_INST, INST_FIN=Tfin),
    NEWTON=_F(MATRICE="TANGENTE", REAC_ITER=1),
    CONVERGENCE=_F(ITER_GLOB_MAXI=20, RESI_GLOB_RELA=ResiGlobRela),
    SOLVEUR=_F(ACCELERATION="FR"),
)
RESU = CALC_CHAMP(
    RESULTAT=RESU, reuse=RESU, TOUT="OUI", TOUT_ORDRE="OUI", DEFORMATION=("EPSI_ELGA",)
)

SIXX = RECU_FONCTION(RESULTAT=RESU, NOM_CHAM="SIEF_ELGA", GROUP_MA="M1", POINT=1, NOM_CMP="SIXX")
SIYY = RECU_FONCTION(RESULTAT=RESU, NOM_CHAM="SIEF_ELGA", GROUP_MA="M1", POINT=1, NOM_CMP="SIYY")
SIZZ = RECU_FONCTION(RESULTAT=RESU, NOM_CHAM="SIEF_ELGA", GROUP_MA="M1", POINT=1, NOM_CMP="SIZZ")
BR_AVCHI = RECU_FONCTION(
    RESULTAT=RESU, NOM_CHAM="VARI_ELGA", GROUP_MA="M1", POINT=1, NOM_VARI="BR_AVCHI"
)
BR_PRGEL = RECU_FONCTION(
    RESULTAT=RESU, NOM_CHAM="VARI_ELGA", GROUP_MA="M1", POINT=1, NOM_VARI="BR_PRGEL"
)
BR_PRCAP = RECU_FONCTION(
    RESULTAT=RESU, NOM_CHAM="VARI_ELGA", GROUP_MA="M1", POINT=1, NOM_VARI="BR_PRCAP"
)

temps_tests = np.array([10.0, 40.0, 80.0, 100.0, 110.0, 200.0])
val_NR_BR_AVCHI = [
    4.981672300000e-03,
    5.361980200000e-01,
    0.59382808034267,
    0.5938301328580,
    0.59384230907776,
    7.000000000000e-01,
]
val_NR_BR_PRGEL = [
    0.0,
    2.097875634596e06,
    2.457487221338e06,
    2.457500026087e06,
    2.457576008645e06,
    3.120000000000e06,
]
val_NR_BR_PRCAP = [
    -2.810249100000e06,
    -2.529791200000e06,
    -2.861817600000e06,
    -2.142428500000e06,
    -2.142428500000e06,
    -2.142428528563e06,
]
val_NR_SIXX = [
    2810249.099279279355,
    431915.61173248011619,
    404330.38291293894872,
    -315071.4975538989529,
    -315147.48011006461456,
    -977571.47143986402079,
]
val_NR_SIYY = [
    2810249.099279279355,
    431915.61173248011619,
    404330.38291293894872,
    -315071.4975538989529,
    -315147.48011006461456,
    -977571.47143986402079,
]
val_NR_SIZZ = [
    2810249.099279279355,
    431915.61173248011619,
    404330.38291293894872,
    -315071.4975538989529,
    -315147.48011006461456,
    -977571.47143986402079,
]

analy_BR_AVCHI = [0.00499878, 0.53595897, 0.59373457, 0.59374018, 0.59387783, 0.70007016]
analy_BR_PRGEL = np.array(
    [0.0, 2096383.97470061, 2456903.73459854, 2456938.75040395, 2457797.63638326, 3120437.8194528]
)
analy_BR_PRCAP = np.array(
    [
        -2810249.09927928,
        -2529791.24632844,
        -2861817.60425084,
        -2142428.52856285,
        -2142428.52856285,
        -2142428.52856285,
    ]
)
analy_SIXX = [
    2810249.09927928,
    433407.27162783,
    404913.86965229,
    -314510.22184109,
    -315369.1078204,
    -978009.29088995,
]
analy_SIYY = analy_SIXX
analy_SIZZ = analy_SIXX

tests_AVCHI = [
    _F(
        FONCTION=BR_AVCHI,
        NOM_PARA="INST",
        CRITERE="RELATIF",
        REFERENCE="SOURCE_EXTERNE",
        VALE_PARA=temps_tests[i],
        VALE_CALC=val_NR_BR_AVCHI[i],
        VALE_REFE=analy_BR_AVCHI[i],
        PRECISION=5.0e-3,
    )
    for i in range(len(temps_tests))
]

tests_BR_PRGEL = [
    _F(
        FONCTION=BR_PRGEL,
        NOM_PARA="INST",
        CRITERE="ABSOLU",
        REFERENCE="SOURCE_EXTERNE",
        VALE_PARA=temps_tests[0],
        VALE_CALC=val_NR_BR_PRGEL[0],
        VALE_REFE=analy_BR_PRGEL[0],
        PRECISION=5.0e-3,
    )
] + [
    _F(
        FONCTION=BR_PRGEL,
        NOM_PARA="INST",
        CRITERE="RELATIF",
        REFERENCE="SOURCE_EXTERNE",
        VALE_PARA=temps_tests[i],
        VALE_CALC=val_NR_BR_PRGEL[i],
        VALE_REFE=analy_BR_PRGEL[i],
        PRECISION=5.0e-3,
    )
    for i in range(1, len(temps_tests))
]

tests_BR_PRCAP = [
    _F(
        FONCTION=BR_PRCAP,
        NOM_PARA="INST",
        CRITERE="RELATIF",
        REFERENCE="SOURCE_EXTERNE",
        VALE_PARA=temps_tests[i],
        VALE_CALC=val_NR_BR_PRCAP[i],
        VALE_REFE=analy_BR_PRCAP[i],
        PRECISION=5.0e-3,
    )
    for i in range(len(temps_tests))
]
tests_SIXX = [
    _F(
        FONCTION=SIXX,
        NOM_PARA="INST",
        CRITERE="RELATIF",
        REFERENCE="SOURCE_EXTERNE",
        VALE_PARA=temps_tests[i],
        VALE_CALC=val_NR_SIXX[i],
        VALE_REFE=analy_SIXX[i],
        PRECISION=5.0e-3,
    )
    for i in range(len(temps_tests))
]

tests_SIYY = [
    _F(
        FONCTION=SIYY,
        NOM_PARA="INST",
        CRITERE="RELATIF",
        REFERENCE="SOURCE_EXTERNE",
        VALE_PARA=temps_tests[i],
        VALE_CALC=val_NR_SIYY[i],
        VALE_REFE=analy_SIYY[i],
        PRECISION=5.0e-3,
    )
    for i in range(len(temps_tests))
]

tests_SIZZ = [
    _F(
        FONCTION=SIZZ,
        NOM_PARA="INST",
        CRITERE="RELATIF",
        REFERENCE="SOURCE_EXTERNE",
        VALE_PARA=temps_tests[i],
        VALE_CALC=val_NR_SIZZ[i],
        VALE_REFE=analy_SIZZ[i],
        PRECISION=5.0e-3,
    )
    for i in range(len(temps_tests))
]

tests = tests_AVCHI + tests_BR_PRGEL + tests_BR_PRCAP + tests_SIXX + tests_SIYY + tests_SIZZ

TEST_FONCTION(VALEUR=tests)

FIN()
