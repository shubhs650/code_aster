from code_aster.Commands import *
from code_aster import CA
from code_aster.CA import MPI

if MPI.ASTER_COMM_WORLD.Get_size() > 1:
    is_parallel = True
else:
    is_parallel = False

from code_aster.LinearAlgebra.POD import (
    PODAnalysis,
    computeProjectionErrors,
    extractSnapshotsFromResult,
    is_orthonormal_basis,
    transferSnapshotsToPETSC,
)

test = CA.TestCase()

# --------------------------------------------------------------------
#   HF COMPUTATION
# --------------------------------------------------------------------

DEBUT(CODE="OUI", ERREUR=_F(ALARME="EXCEPTION"), DEBUG=_F(SDVERI="OUI"))

mesh = LIRE_MAILLAGE(FORMAT="MED")

mesh = MODI_MAILLAGE(reuse=mesh, MAILLAGE=mesh, ORIE_PEAU=_F(GROUP_MA_PEAU="S_e"))

# Define the material
steel = DEFI_MATERIAU(ELAS=_F(E=210000.0, NU=0.3), ECRO_LINE=_F(D_SIGM_EPSI=100.0, SY=100.0))

chmat = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(TOUT="OUI", MATER=steel))
# Mechanic model
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"))

# Boundary condition
chg_b = AFFE_CHAR_CINE(MODELE=model, MECA_IMPO=_F(GROUP_MA="S_inf", DX=0, DY=0.0, DZ=0))

chg_p = AFFE_CHAR_MECA(MODELE=model, PRES_REP=_F(GROUP_MA="S_e", PRES=1000))

# Time discretization
list_t = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=10.0, PAS=1.0))

list_i = DEFI_LIST_INST(METHODE="MANUEL", DEFI_LIST=_F(LIST_INST=list_t))

rampe = DEFI_FONCTION(NOM_PARA="INST", VALE=(0.0, 0.0, 10.0, 1.0))

# Complete computation to create base
stnl = STAT_NON_LINE(
    MODELE=model,
    CHAM_MATER=chmat,
    EXCIT=(_F(CHARGE=chg_b), _F(CHARGE=chg_p, FONC_MULT=rampe)),
    INCREMENT=_F(LIST_INST=list_i),
    COMPORTEMENT=_F(RELATION="VMIS_ISOT_LINE"),
)

stnl = CALC_CHAMP(reuse=stnl, RESULTAT=stnl, CONTRAINTE="SIEF_NOEU")

# --------------------------------------------------------------------
#   TEST THE EXTRACTION PROCEDURE FROM THE RESULT
# --------------------------------------------------------------------


def test_singular_values(singval_num, singval_ref, msg_end):
    test_array_floats(singval_num, singval_ref, "singval = ", msg_end)


def test_array_floats(arr_num, arr_ref, msg_begin, msg_end):
    for i in range(len(arr_ref)):
        test.assertAlmostEqual(arr_num[i], arr_ref[i], msg=msg_begin + str(i) + " " + msg_end)


nDOF = 192
n_cut = 3

indices_A = [1, 2, 3]
indices_B = [4, 5, 6, 7, 8, 9, 10]

arrPetsc_depl = extractSnapshotsFromResult(stnl, "DEPL", indexSteps=None, format="petsc")

arrPetsc_depl_A = extractSnapshotsFromResult(stnl, "DEPL", indexSteps=indices_A, format="petsc")
arrPetsc_depl_B = extractSnapshotsFromResult(stnl, "DEPL", indexSteps=indices_B, format="petsc")


if not is_parallel:
    arr_depl_A = extractSnapshotsFromResult(stnl, "DEPL", indexSteps=indices_A, format="numpy")
    arr_depl_B = extractSnapshotsFromResult(stnl, "DEPL", indexSteps=indices_B, format="numpy")
    arrPetsc_depl_A_bis = transferSnapshotsToPETSC(arr_depl_A)
    arrPetsc_depl_B_bis = transferSnapshotsToPETSC(arr_depl_B)

# - Compute the ROB using the snapshot method
POD_An_A = PODAnalysis.factory(
    arrPetsc_depl_A, method="snapshot", criterion="energy", tolerance=1e-5
)
Phi_A, singval_A = POD_An_A.computePODBasis(option=2)

test.assertEqual(Phi_A.getSize()[0], nDOF)
test.assertEqual(Phi_A.getSize()[1], 2)

POD_An_B = PODAnalysis.factory(
    arrPetsc_depl_B, method="snapshot", criterion="energy", tolerance=1e-5
)
Phi_B, singval_B = POD_An_B.computePODBasisIncremental(Phi_A, singval_A, method="HPOD", option=2)

singval_B_ref = [6.60693745e-01, 2.38644383e-03, 4.94061245e-02, 3.19205110e-03, 2.19501875e-04]
test_singular_values(singval_B, singval_B_ref, " using incr-POD (HPOD)")
test.assertEqual(Phi_B.getSize()[0], nDOF, msg="Test incremental POD with HPOD - number of DOFs")
test.assertEqual(Phi_B.getSize()[1], 5, msg="Test incremental POD with HPOD - number of modes")

Phi_B2, singval_B2 = POD_An_B.computePODBasisIncremental(Phi_A, singval_A, method="HAPOD", option=2)
singval_B2_ref = [5.0746443, 0.01659096]
test_singular_values(singval_B2, singval_B2_ref, " using incr-POD (HAPOD)")

test.assertEqual(Phi_B2.getSize()[0], nDOF, msg="Test incremental POD with HAPOD - number of DOFs")
test.assertEqual(Phi_B2.getSize()[1], 2, msg="Test incremental POD with HAPOD - number of modes")

# - Test with transfer from numpy to petsc
if not is_parallel:
    POD_An_A_bis = PODAnalysis.factory(
        arrPetsc_depl_A_bis, method="snapshot", criterion="energy", tolerance=1e-5
    )
    Phi_A_bis, singval_A_bis = POD_An_A.computePODBasis(option=2)

    test.assertEqual(Phi_A_bis.getSize()[0], nDOF)
    test.assertEqual(Phi_A_bis.getSize()[1], 2)

    POD_An_B_bis = PODAnalysis.factory(
        arrPetsc_depl_B_bis, method="snapshot", criterion="energy", tolerance=1e-5
    )
    Phi_B_bis, singval_B_bis = POD_An_B.computePODBasisIncremental(
        Phi_A_bis, singval_A_bis, method="HPOD", option=2
    )
    test_singular_values(singval_B_bis, singval_B_ref, " using incr-POD (HPOD)")
    test.assertEqual(
        Phi_B_bis.getSize()[0], nDOF, msg="Test incremental POD with HPOD - number of DOFs"
    )
    test.assertEqual(
        Phi_B_bis.getSize()[1], 5, msg="Test incremental POD with HPOD - number of modes"
    )

    Phi_B2_bis, singval_B2_bis = POD_An_B.computePODBasisIncremental(
        Phi_A, singval_A, method="HAPOD", option=2
    )
    test_singular_values(singval_B2, singval_B2_ref, " using incr-POD (HAPOD)")
    test.assertEqual(
        Phi_B2_bis.getSize()[0], nDOF, msg="Test incremental POD with HAPOD - number of DOFs"
    )
    test.assertEqual(
        Phi_B2_bis.getSize()[1], 2, msg="Test incremental POD with HAPOD - number of modes"
    )


# --------------------------------------------------------------------
#   TEST ON THE ABSOLUTE PROJECTION ERRORS
# --------------------------------------------------------------------
abs_errors, _ = computeProjectionErrors(Phi_B, arrPetsc_depl)
abs_errors_ref = [
    0.00000000e00,
    9.78934372e-05,
    6.47339793e-05,
    3.07300574e-05,
    7.53159321e-06,
    6.18178554e-06,
    5.10500826e-06,
    9.05533265e-07,
    4.93503036e-06,
    3.68256779e-06,
    4.32878011e-06,
]
test_array_floats(abs_errors_ref, abs_errors, "Absolute errors - ", "- case SVD")

abs_errors, _ = computeProjectionErrors(Phi_B2, arrPetsc_depl)
abs_errors_ref = [
    0.0,
    0.00181116,
    0.00205585,
    0.00113663,
    0.00026387,
    0.00059264,
    0.00091257,
    0.00087843,
    0.00051098,
    0.00017178,
    0.00108799,
]
test_array_floats(abs_errors_ref, abs_errors, "Absolute errors - ", "- case SVD")

# --------------------------------------------------------------------
#   TEST FOR ORTHONORMALITY
# --------------------------------------------------------------------
test.assertTrue(is_orthonormal_basis(Phi_B, POD_An_B._corrOperator), msg="Orthonormality test - 1")
test.assertTrue(is_orthonormal_basis(Phi_B, POD_An_B._corrOperator), msg="Orthonormality test - 2")

FIN()
