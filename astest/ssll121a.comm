DEBUT(CODE="OUI", ERREUR=_F(ALARME="EXCEPTION"))

import math

# 1. Données

E = 2.0e11  # Module d'Young

R = 0.5  # Rayon extérieur
ep = 0.10  # épaisseur
L = 10.0  # Longueur

effort = 1.0e06  # effort appliqué en extrémité de poutre


# 2. Calcul théorique


def inertie(R, ep):
    dext = 2 * R
    dint = dext - 2 * ep
    return math.pi * (dext**4 - dint**4) / 64


def sipo(cflex_xy, cflex_xz, isigm_xy, isigm_xz, FY, FZ):
    """Renvoie les contraintes sipo et les flèches par direction"""

    flecheZ, contrainteY = sipo_dir(cflex_xy, isigm_xy, FZ)
    flecheY, contrainteZ = sipo_dir(cflex_xz, isigm_xz, FY)

    return {"Y": (flecheY, contrainteY), "Z": (flecheZ, contrainteZ)}


def sipo_dir(cflex, sif, F):
    Igeo = inertie(R, ep)
    I = Igeo / cflex

    Mf = -F * L
    fleche = F * L**3 / (3 * E * I)

    contrainte = sif * Mf / Igeo * R

    return fleche, contrainte


# 3. Calcul code_aster et test

MAIL = LIRE_MAILLAGE(FORMAT="ASTER", UNITE=20)

MODELE = AFFE_MODELE(
    MAILLAGE=MAIL, AFFE=(_F(GROUP_MA=("GA"), PHENOMENE="MECANIQUE", MODELISATION="POU_D_T"),)
)

MATER = DEFI_MATERIAU(ELAS=_F(E=2.0e011, NU=0.0))

CHMAT = AFFE_MATERIAU(MAILLAGE=MAIL, AFFE=_F(GROUP_MA=("GA"), MATER=MATER))

BLOC = AFFE_CHAR_MECA(
    MODELE=MODELE, DDL_IMPO=_F(GROUP_NO="FIXA", DX=0.0, DY=0.0, DZ=0.0, DRX=0.0, DRY=0.0, DRZ=0.0)
)


LOAD_Y = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TIPA", FY=effort))

LOAD_Z = AFFE_CHAR_MECA(MODELE=MODELE, FORCE_NODALE=_F(GROUP_NO="TIPA", FZ=effort))
loads = {"Y": LOAD_Y, "Z": LOAD_Z}

lcas = [(1, 1, 1, 1), (2, 1, 1, 1), (1, 2, 1, 1), (1, 1, 3, 4), (2, 2, 3, 4)]

for cflex_xy, cflex_xz, isigm_xy, isigm_xz in lcas:
    CARA = AFFE_CARA_ELEM(
        MODELE=MODELE,
        POUTRE=(
            _F(GROUP_MA="GA", SECTION="CERCLE", CARA=("R", "EP"), VALE=(R, ep)),
            _F(
                GROUP_MA="GA",
                SECTION="COUDE",
                COEF_FLEX_XY=cflex_xy,
                COEF_FLEX_XZ=cflex_xz,
                INDI_SIGM_XY=isigm_xy,
                INDI_SIGM_XZ=isigm_xz,
            ),
        ),
        ORIENTATION=_F(GROUP_MA="GA", CARA="VECT_Y", VALE=(0.0, 1.0, 0.0)),
    )

    for load_label, load in loads.items():
        # TEST AVEC MECA STATIQUE

        RESU = MECA_STATIQUE(
            MODELE=MODELE,
            CHAM_MATER=CHMAT,
            CARA_ELEM=CARA,
            EXCIT=(_F(CHARGE=BLOC), _F(CHARGE=load)),
            SOLVEUR=_F(METHODE="MULT_FRONT"),
        )

        titre = f"MECA_STATIQUE_{cflex_xy}_{cflex_xz}_{isigm_xy}_{isigm_xz}_LOAD_{load_label}"
        RESU = CALC_CHAMP(reuse=RESU, RESULTAT=RESU, CONTRAINTE=("SIPO_NOEU",))

        TAB_SIPO = CREA_TABLE(
            RESU=_F(
                RESULTAT=RESU,
                GROUP_NO="FIXA",
                NOM_CHAM="SIPO_NOEU",
                NOM_CMP=("SMFY", "SMFZ"),
                PRECISION=1.0e-12,
            )
        )

        FLECHES = CREA_TABLE(
            RESU=_F(
                RESULTAT=RESU, GROUP_NO="TIPA", NOM_CHAM="DEPL", TOUT_CMP="OUI", PRECISION=1.0e-12
            )
        )

        if load_label == "Y":
            resultat_theorique = sipo(cflex_xy, cflex_xz, isigm_xy, isigm_xz, effort, 0)
        else:
            resultat_theorique = sipo(cflex_xy, cflex_xz, isigm_xy, isigm_xz, 0, effort)

        TEST_TABLE(
            REFERENCE="ANALYTIQUE",
            CRITERE="ABSOLU",
            PRECISION=1.0e-5,
            TOLE_MACHINE=1.0e-5,
            VALE_CALC=resultat_theorique["Y"][1],
            VALE_REFE=resultat_theorique["Y"][1],
            NOM_PARA="SMFY",
            TABLE=TAB_SIPO,
            FILTRE=_F(NOM_PARA="NOEUD", VALE_K="1"),
        )

        TEST_TABLE(
            REFERENCE="ANALYTIQUE",
            CRITERE="ABSOLU",
            PRECISION=1.0e-5,
            TOLE_MACHINE=1.0e-5,
            VALE_CALC=resultat_theorique["Z"][1],
            VALE_REFE=resultat_theorique["Z"][1],
            NOM_PARA="SMFZ",
            TABLE=TAB_SIPO,
            FILTRE=_F(NOM_PARA="NOEUD", VALE_K="1"),
        )

        TEST_TABLE(
            REFERENCE="ANALYTIQUE",
            CRITERE="ABSOLU",
            PRECISION=1e-3,
            TOLE_MACHINE=1e-3,
            VALE_CALC=resultat_theorique["Y"][0],
            VALE_REFE=resultat_theorique["Y"][0],
            NOM_PARA="DY",
            TABLE=FLECHES,
            FILTRE=_F(NOM_PARA="NOEUD", VALE_K="3"),
        )

        TEST_TABLE(
            REFERENCE="ANALYTIQUE",
            CRITERE="ABSOLU",
            PRECISION=1e-3,
            TOLE_MACHINE=1e-3,
            VALE_CALC=resultat_theorique["Z"][0],
            VALE_REFE=resultat_theorique["Z"][0],
            NOM_PARA="DZ",
            TABLE=FLECHES,
            FILTRE=_F(NOM_PARA="NOEUD", VALE_K="3"),
        )

        # IMPR_TABLE(TABLE=TAB_SIPO,UNITE=70,TITRE = titre)

        # TEST AVEC STAT_NON_LINE

        Linst = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=1))

        FMult = DEFI_FONCTION(NOM_PARA="INST", VALE=(0.0, 0.0, 1.0, 1.0))

        RESU_SNL = STAT_NON_LINE(
            MODELE=MODELE,
            CHAM_MATER=CHMAT,
            CARA_ELEM=CARA,
            EXCIT=(_F(CHARGE=BLOC), _F(CHARGE=load, FONC_MULT=FMult)),
            INCREMENT=_F(LIST_INST=Linst),
            SOLVEUR=_F(METHODE="MULT_FRONT"),
        )

        titre = f"STAT_NON_LINE_{cflex_xy}_{cflex_xz}_{isigm_xy}_{isigm_xz}_LOAD_{load_label}"
        RESU_SNL = CALC_CHAMP(reuse=RESU_SNL, RESULTAT=RESU_SNL, CONTRAINTE=("SIPO_NOEU",))

        TAB_SIPO = CREA_TABLE(
            RESU=_F(
                RESULTAT=RESU_SNL,
                GROUP_NO="FIXA",
                NOM_CHAM="SIPO_NOEU",
                NOM_CMP=("SMFY", "SMFZ"),
                PRECISION=1.0e-12,
                INST=1.0,
            )
        )

        FLECHES = CREA_TABLE(
            RESU=_F(
                RESULTAT=RESU_SNL,
                GROUP_NO="TIPA",
                NOM_CHAM="DEPL",
                TOUT_CMP="OUI",
                PRECISION=1.0e-12,
                INST=1.0,
            )
        )

        TEST_TABLE(
            REFERENCE="ANALYTIQUE",
            CRITERE="ABSOLU",
            PRECISION=1.0e-5,
            TOLE_MACHINE=1.0e-5,
            VALE_CALC=resultat_theorique["Y"][1],
            VALE_REFE=resultat_theorique["Y"][1],
            NOM_PARA="SMFY",
            TABLE=TAB_SIPO,
            FILTRE=_F(NOM_PARA="NOEUD", VALE_K="1"),
        )

        TEST_TABLE(
            REFERENCE="ANALYTIQUE",
            CRITERE="ABSOLU",
            PRECISION=1.0e-5,
            TOLE_MACHINE=1.0e-5,
            VALE_CALC=resultat_theorique["Z"][1],
            VALE_REFE=resultat_theorique["Z"][1],
            NOM_PARA="SMFZ",
            TABLE=TAB_SIPO,
            FILTRE=_F(NOM_PARA="NOEUD", VALE_K="1"),
        )

        TEST_TABLE(
            REFERENCE="ANALYTIQUE",
            CRITERE="ABSOLU",
            PRECISION=1e-3,
            TOLE_MACHINE=1e-3,
            VALE_CALC=resultat_theorique["Y"][0],
            VALE_REFE=resultat_theorique["Y"][0],
            NOM_PARA="DY",
            TABLE=FLECHES,
            FILTRE=_F(NOM_PARA="NOEUD", VALE_K="3"),
        )

        TEST_TABLE(
            REFERENCE="ANALYTIQUE",
            CRITERE="ABSOLU",
            PRECISION=1e-3,
            TOLE_MACHINE=1e-3,
            VALE_CALC=resultat_theorique["Z"][0],
            VALE_REFE=resultat_theorique["Z"][0],
            NOM_PARA="DZ",
            TABLE=FLECHES,
            FILTRE=_F(NOM_PARA="NOEUD", VALE_K="3"),
        )

FIN()
