
import sympy as sp

# ----------------------------------------------------------------------
# Variables
# ----------------------------------------------------------------------
r, z = sp.symbols('r z', real=True)

# ----------------------------------------------------------------------
# Définition de la solution manufacturée
# ----------------------------------------------------------------------
# Exemple simple :
# T = r**2 + z**2

# Exemple plus riche (ordre plus élevé) :
T = r**5 + z**5 - r*r*z

# ----------------------------------------------------------------------
# Opérateur axisymétrique thermique :
#   - (1/r * d_r (r d_r T) + d²_z T)
# ----------------------------------------------------------------------

# dT/dr
dT_dr = sp.diff(T, r)

# r * dT/dr
r_dT_dr = r * dT_dr

# d/dr (r * dT/dr)
dr_r_dT_dr = sp.diff(r_dT_dr, r)

# 1/r * ...
term_r = dr_r_dT_dr / r

# d²T/dz²
d2T_dz2 = sp.diff(T, z, 2)

# Source f
f = - (term_r + d2T_dz2)

# ----------------------------------------------------------------------
# Simplification
# ----------------------------------------------------------------------
f_simplified = sp.simplify(f)

# ----------------------------------------------------------------------
# Affichage
# ----------------------------------------------------------------------
print("\n=== Solution manufacturée T(r,z) ===")
sp.pprint(T)

print("\n=== Second membre f(r,z) ===")
sp.pprint(f_simplified)