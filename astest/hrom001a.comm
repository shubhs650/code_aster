from code_aster.Commands import *
from code_aster import CA

try:
    import matplotlib

    matplotlib.use("TkAgg")
    import matplotlib.pyplot as plt

    HAS_MATPLOTLIB = True
    matplotlib.rcParams["mathtext.fontset"] = "stix"
    matplotlib.rcParams["font.family"] = "STIXGeneral"
except ImportError:
    HAS_MATPLOTLIB = False

import os

import numpy as np

from code_aster.LinearAlgebra.POD import (
    PODAnalysis,
    computeProjectionErrors,
    extractSnapshotsFromResult,
    is_orthonormal_basis,
)

test = CA.TestCase()

# --------------------------------------------------------------------
#   HF COMPUTATION
# --------------------------------------------------------------------

DEBUT(CODE="OUI", ERREUR=_F(ALARME="EXCEPTION"), DEBUG=_F(SDVERI="OUI"))

mesh = LIRE_MAILLAGE(FORMAT="MED")

mesh = MODI_MAILLAGE(reuse=mesh, MAILLAGE=mesh, ORIE_PEAU=_F(GROUP_MA_PEAU="S_e"))

# Define the material
steel = DEFI_MATERIAU(ELAS=_F(E=210000.0, NU=0.3), ECRO_LINE=_F(D_SIGM_EPSI=100.0, SY=100.0))

chmat = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(TOUT="OUI", MATER=steel))
# Mechanic model
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"))

# Boundary condition
chg_b = AFFE_CHAR_CINE(MODELE=model, MECA_IMPO=_F(GROUP_MA="S_inf", DX=0, DY=0.0, DZ=0))

chg_p = AFFE_CHAR_MECA(MODELE=model, PRES_REP=_F(GROUP_MA="S_e", PRES=1000))

# Time discretization
list_t = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=10.0, PAS=1.0))

list_i = DEFI_LIST_INST(METHODE="MANUEL", DEFI_LIST=_F(LIST_INST=list_t))

rampe = DEFI_FONCTION(NOM_PARA="INST", VALE=(0.0, 0.0, 10.0, 1.0))

# Complete computation to create base
stnl = STAT_NON_LINE(
    MODELE=model,
    CHAM_MATER=chmat,
    EXCIT=(_F(CHARGE=chg_b), _F(CHARGE=chg_p, FONC_MULT=rampe)),
    INCREMENT=_F(LIST_INST=list_i),
    COMPORTEMENT=_F(RELATION="VMIS_ISOT_LINE"),
)

stnl = CALC_CHAMP(reuse=stnl, RESULTAT=stnl, CONTRAINTE="SIEF_NOEU")

# --------------------------------------------------------------------
#   TEST THE EXTRACTION PROCEDURE FROM THE RESULT
# --------------------------------------------------------------------

arr_depl = extractSnapshotsFromResult(stnl, "DEPL", "numpy")
arr_sief_noe = extractSnapshotsFromResult(stnl, "SIEF_NOEU", "numpy")

nDOF = 192
nELGA_SIEF = 384
nTimeSteps = 11
# - Tests
test.assertEqual(arr_depl.shape[0], nDOF, msg="Test initialisation array PETSc - 1")
test.assertEqual(arr_depl.shape[1], nTimeSteps, msg="Test initialisation array PETSc - 2")
test.assertEqual(arr_sief_noe.shape[0], nELGA_SIEF, msg="Test initialisation array PETSc - 3")
test.assertEqual(arr_sief_noe.shape[1], nTimeSteps, msg="Test initialisation array PETSc - 4")

arr_depl_1 = extractSnapshotsFromResult(stnl, "DEPL", "numpy", 1)
test.assertEqual(arr_depl_1.shape[1], 1)

arr_depl_2 = extractSnapshotsFromResult(stnl, "DEPL", "numpy", [1, 5])
test.assertEqual(arr_depl_2.shape[1], 2)


# --------------------------------------------------------------------
#   TEST ROB CONSTRUCTION FROM THE EXTRACTED RESULT
# --------------------------------------------------------------------
def test_singular_values(singval_num, singval_ref, msg_end):
    test_array_floats(singval_num, singval_ref, "singval = ", msg_end)


def test_array_floats(arr_num, arr_ref, msg_begin, msg_end):
    for i in range(len(arr_ref)):
        test.assertAlmostEqual(arr_num[i], arr_ref[i], msg=msg_begin + str(i) + " " + msg_end)


# - Compute the ROB using the snapshot method
POD_An1 = PODAnalysis.factory(arr_depl, method="snapshot", criterion="energy", tolerance=1e-5)
Phi_1, singval = POD_An1.computePODBasis(option=2)
dRate = POD_An1.computeDecayRate(singval)
test.assertAlmostEqual(dRate, -8.255, places=3)
test.assertEqual(Phi_1.shape[0], nDOF)
test.assertEqual(Phi_1.shape[1], 2)

singval_An1_ref = [5.0746443, 0.01660781]
test_singular_values(singval, singval_An1_ref, msg_end="using snapshot")

singval_An2_ref = [5.07464430e00, 1.66078074e-02, 3.09228298e-03]
POD_An2 = PODAnalysis.factory(arr_depl, method="snapshot", criterion="nbModes", nbModes=3)
Phi_2, singval = POD_An2.computePODBasis(option=2)
test.assertEqual(Phi_2.shape[1], 3, msg="snapshot - nbModes - depl")
test_singular_values(singval, singval_An2_ref, msg_end="using snapshot")

# - Compute the ROB using SVD
singval_An3_ref = [5.07464430e00, 1.66078074e-02, 3.09228298e-03, 1.58907559e-03]
POD_An3 = PODAnalysis.factory(arr_depl, method="SVD", criterion="nbModes", nbModes=4)
Phi_3, singval = POD_An3.computePODBasis(option=2)
test.assertEqual(Phi_3.shape[1], 4, msg="SVD - depl")
test_singular_values(singval, singval_An3_ref, msg_end="using SVD")

# - Compute the ROB using Gram-Schmidt
singval_An4_ref = [
    5.69003196e-03,
    9.18862194e-02,
    4.29590502e-03,
    1.06320901e-03,
    4.22215326e-04,
    3.99430747e-05,
    4.13119530e-05,
]
POD_An4 = PODAnalysis.factory(arr_depl, method="GS-classical", criterion="energy", tolerance=1e-5)
Phi_4, singval = POD_An4.computePODBasis(option=2)
test.assertEqual(Phi_4.shape[1], 7, msg="GS-classical - depl")
test_singular_values(singval, singval_An4_ref, msg_end="using GS-classical")


singval_An5_ref = [
    5.69003196e-03,
    9.18862194e-02,
    4.29590502e-03,
    1.06320901e-03,
    4.22215326e-04,
    3.99430747e-05,
    4.13119530e-05,
]
POD_An5 = PODAnalysis.factory(arr_depl, method="GS-modified", criterion="energy", tolerance=1e-5)
Phi_5, singval = POD_An5.computePODBasis(option=2)
test.assertEqual(Phi_5.shape[1], 7, msg="GS-modified - depl")
test_singular_values(singval, singval_An5_ref, msg_end="using GS-modified")


abs_errors, _ = computeProjectionErrors(Phi_3, arr_depl)
abs_errors_ref = [
    0.00000000e00,
    8.96514117e-05,
    2.94810994e-04,
    1.80094937e-04,
    1.79255363e-04,
    5.64140803e-05,
    6.13216146e-05,
    1.18767500e-04,
    1.06222287e-04,
    2.36268765e-05,
    1.24637040e-04,
]
test_array_floats(abs_errors_ref, abs_errors, "Absolute errors - ", "- case SVD")
# --------------------------------------------------------------------
#   VISUALISATION IF NEED TO UNDERSTAND
# --------------------------------------------------------------------
"""Nothing will be plotted if matplotlib is unavailable.
A plot will be geenrated if matplotlib is available:
    - interactive=True and the code is run in a interactive section
    - interactive=False and no savedir is given"""
interactive = False
savedir = None


def print_semilog_byhand(arr_values):
    """
    Generate semilog figure using matplotlib

    arr_values: numpy.ndarray
        Array to plot
    (can be used to overcome floatting point error)
    """
    fontsize_ticks = 15
    fontsize_labels = 18
    log_data = np.log10(arr_values)
    x_data = np.arange(1, len(arr_values) + 1)
    plt.figure(figsize=(8, 6))
    plt.plot(x_data, log_data, marker="o", linestyle="-")
    min_power = np.floor(log_data.min())
    max_power = np.ceil(log_data.max())
    tick_positions = np.arange(min_power, max_power + 1)
    tick_labels = []
    for p in tick_positions:
        if p == 0:
            tick_labels.append("1")
        elif p == 1:
            tick_labels.append("10")
        else:
            label = "$10^{" + str(int(p)) + "}$"
            tick_labels.append(label)

    plt.yticks(tick_positions, tick_labels, fontsize=15)
    plt.grid(True, which="both", linestyle="--")
    plt.xticks(x_data, fontsize=15)


if HAS_MATPLOTLIB:
    if (interactive == False and savedir is not None) or (interactive == True):
        singval_An3_ref_norm = [val / singval_An3_ref[0] for val in singval_An3_ref]
        print_semilog_byhand(singval_An3_ref_norm)
        plt.xlabel(r"Index", fontsize=18)
        plt.ylabel(r"Normalized singular value $\sigma_i$", fontsize=18)
        plt.tight_layout()

        if interactive == False and savedir is not None:
            plt.savefig(os.path.join(savedir, "singular_values.png"))
        else:
            plt.show()

# --------------------------------------------------------------------
#   TEST FOR ORTHONORMALITY
# --------------------------------------------------------------------
test.assertTrue(is_orthonormal_basis(Phi_1, POD_An1._corrOperator), msg="Orthonormality test - 1")
test.assertTrue(is_orthonormal_basis(Phi_2, POD_An2._corrOperator), msg="Orthonormality test - 2")
test.assertTrue(is_orthonormal_basis(Phi_3, POD_An3._corrOperator), msg="Orthonormality test - 3")
test.assertTrue(is_orthonormal_basis(Phi_4, POD_An4._corrOperator), msg="Orthonormality test - 4")
test.assertTrue(is_orthonormal_basis(Phi_5, POD_An5._corrOperator), msg="Orthonormality test - 5")

FIN()
