from code_aster.Commands import *
from code_aster import CA
from math import isfinite


DEBUT(CODE="OUI", ERREUR=_F(ALARME="ALARME", ERREUR_F="EXCEPTION"))

test = CA.TestCase()

MA = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)
MA = MODI_MAILLAGE(reuse=MA, DEFORME=_F(ALEA=1.0e-8, OPTION="TRAN"), MAILLAGE=MA)
MAIL = CREA_MAILLAGE(MAILLAGE=MA, MODI_MAILLE=_F(OPTION="QUAD8_9", TOUT="OUI"))

MOEL = AFFE_MODELE(
    AFFE=_F(MODELISATION="COQUE_3D", PHENOMENE="MECANIQUE", TOUT="OUI"),
    MAILLAGE=MAIL,
    VERI_NORM_IFS="OUI",
)

CAEL = AFFE_CARA_ELEM(
    COQUE=_F(ANGL_REP=(90.0, 0.0), A_CIS=9000.0, EPAIS=0.00045, GROUP_MA="TOUT_ELT"), MODELE=MOEL
)

MATERIAU = DEFI_MATERIAU(ELAS=_F(E=200000000000.0, NU=0.3))
CHAM_MAT = AFFE_MATERIAU(AFFE=_F(MATER=MATERIAU, TOUT="OUI"), MAILLAGE=MAIL)

fonc = DEFI_FONCTION(NOM_PARA="INST", VALE=(0.0, 0.0, 10.0, 10.0))
listinst = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=10))

CON_LI = AFFE_CHAR_MECA(
    DDL_IMPO=(
        _F(DX=0.0, DY=0.0, GROUP_NO="O_PRIME"),
        _F(DY=0.0, GROUP_NO="E"),
        _F(DZ=0.0, GROUP_NO="CONTOUR"),
    ),
    MODELE=MOEL,
)

CHAR_EDGE = AFFE_CHAR_MECA(MODELE=MOEL, FORCE_ARETE=_F(FZ=-0.025, GROUP_MA="ARETE"))
CHAR_PRES = AFFE_CHAR_MECA(MODELE=MOEL, FORCE_COQUE=_F(GROUP_MA="CYLINDRE", PRES=-1.0))

ASSEMBLAGE(
    CARA_ELEM=CAEL,
    CHAM_MATER=CHAM_MAT,
    CHARGE=(CON_LI,),
    MATR_ASSE=(_F(MATRICE=CO("MAS_RI_M"), OPTION="RIGI_MECA"),),
    MODELE=MOEL,
    NUME_DDL=CO("NU"),
)

RES_NL = STAT_NON_LINE(
    CARA_ELEM=CAEL,
    CHAM_MATER=CHAM_MAT,
    COMPORTEMENT=_F(DEFORMATION="PETIT", RELATION="ELAS", TOUT="OUI"),
    CONVERGENCE=_F(ITER_GLOB_MAXI=300),
    CRIT_STAB=_F(NMAX_CHAR_CRIT=1, TYPE="FLAMBEMENT", COEF_DIM_ESPACE=8, INST=(0.5, 1.0)),
    EXCIT=(
        _F(CHARGE=CHAR_EDGE, FONC_MULT=fonc, TYPE_CHARGE="FIXE_CSTE"),
        _F(CHARGE=CHAR_PRES, FONC_MULT=fonc, TYPE_CHARGE="SUIV"),
        _F(CHARGE=CON_LI, TYPE_CHARGE="FIXE_CSTE"),
    ),
    INCREMENT=_F(LIST_INST=listinst),
    MODELE=MOEL,
    NEWTON=_F(MATRICE="TANGENTE", PREDICTION="TANGENTE", REAC_INCR=1, REAC_ITER=1),
    SOLVEUR=_F(NPREC=9),
)


def geometric_matrix(stress, displacement, *loads):
    kwargs = dict(
        OPTION="RIGI_GEOM",
        MODELE=MOEL,
        CHAM_MATER=CHAM_MAT,
        CARA_ELEM=CAEL,
        SIEF_ELGA=stress,
        DEPL=displacement,
    )
    if loads:
        kwargs["EXCIT"] = tuple(_F(CHARGE=load, TYPE_CHARGE="SUIV") for load in loads)
    elem = CALC_MATR_ELEM(**kwargs)
    return ASSE_MATRICE(MATR_ELEM=elem, NUME_DDL=NU)


# CRIT_STAB uses (K + K_S, K_G) at the current equilibrium state.
# This checks assembly consistency, not the unit-load pencil (K, K_G + K_S).
table_nl = RECU_TABLE(CO=RES_NL, NOM_TABLE="ANALYSE_MODALE").EXTR_TABLE()
for instant in (0.5, 1.0):
    rows = [row for row in table_nl.rows if abs(row["INST"] - instant) < 1.0e-10]
    test.assertEqual(len(rows), 1)
    char_crit_nl = rows[0]["CHAR_CRIT"]
    stress = CREA_CHAMP(
        OPERATION="EXTR", TYPE_CHAM="ELGA_SIEF_R", RESULTAT=RES_NL,
        NOM_CHAM="SIEF_ELGA", INST=instant,
    )
    displacement = CREA_CHAMP(
        OPERATION="EXTR", TYPE_CHAM="NOEU_DEPL_R", RESULTAT=RES_NL,
        NOM_CHAM="DEPL", INST=instant,
    )
    # fonc(instant) = instant: use the same load amplitude as STAT_NON_LINE.
    pressure = AFFE_CHAR_MECA(
        MODELE=MOEL, FORCE_COQUE=_F(GROUP_MA="CYLINDRE", PRES=-instant),
    )
    kg = geometric_matrix(stress, displacement)
    kg_follow = geometric_matrix(stress, displacement, pressure)
    tangent = COMB_MATR_ASSE(
        COMB_R=(
            _F(MATR_ASSE=MAS_RI_M, COEF_R=1.0),
            _F(MATR_ASSE=kg_follow, COEF_R=1.0),
            _F(MATR_ASSE=kg, COEF_R=-1.0),
        ),
    )
    modes = CALC_MODES(
        MATR_RIGI=tangent, MATR_RIGI_GEOM=kg,
        TYPE_RESU="MODE_FLAMB", OPTION="PLUS_PETITE",
        CALC_CHAR_CRIT=_F(NMAX_CHAR_CRIT=1),
        SOLVEUR=_F(NPREC=9),
        SOLVEUR_MODAL=_F(COEF_DIM_ESPACE=8, METHODE="SORENSEN", NMAX_ITER_SOREN=200),
        VERI_MODE=_F(SEUIL=2.5e-08),
    )
    table = RECU_TABLE(CO=modes, NOM_PARA="CHAR_CRIT").EXTR_TABLE()
    char_crit = list(table.CHAR_CRIT.values())[0]
    print(f"INST={instant}: CRIT_STAB={char_crit_nl:.12e}, reconstructed={char_crit:.12e}")
    test.assertTrue(isfinite(char_crit_nl) and char_crit_nl != 0.0)
    test.assertAlmostEqual(
        char_crit / char_crit_nl, 1.0, delta=5.0e-4,
        msg=f"Same-state CRIT_STAB mismatch at INST={instant}: {char_crit}, {char_crit_nl}",
    )

test.printSummary()

FIN()
