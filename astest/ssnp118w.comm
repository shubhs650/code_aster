DEBUT(CODE="OUI", DEBUG=_F(SDVERI="OUI"))

from math import pi, cos, sin

### >>>>>>>>>>>>>
### Read the mesh
### <<<<<<<<<<<<<

MA = LIRE_MAILLAGE(FORMAT="MED")

### >>>>>>>>>>>>>>>>
### Affect the model
### <<<<<<<<<<<<<<<<

MO = AFFE_MODELE(
    MAILLAGE=MA,
    AFFE=(
        _F(GROUP_MA=("CUBE"), PHENOMENE="MECANIQUE", MODELISATION="3D"),
        _F(GROUP_MA=("CUBEDEG"), PHENOMENE="MECANIQUE", MODELISATION="3D_INTERFACE"),
    ),
)

ORIEN_FI = AFFE_CARA_ELEM(MODELE=MO, MASSIF=(_F(GROUP_MA="CUBEDEG", ANGL_REP=(30, 0, 0))))

### >>>>>>>>>>>>>>>>>>>
### Material properties
### <<<<<<<<<<<<<<<<<<<

E = 0.5e6
NU = 0
KN = 3e12
KT = 3e12
COHE = 1e6
FROT = 0.5
L = 1  # length of the cube
R = 10 * E / L

MAT = DEFI_MATERIAU(
    ELAS=_F(E=E, NU=NU),
    CZM_FROT_MIX=_F(
        RIGI_NOR=KN, RIGI_TAN=KT, ADHE="ELAS", COHESION=COHE, COEF_FROT=FROT, PENA_LAGR_ABSO=R
    ),
)

### >>>>>>>>>>>>>>>>>>>>
### Material affectation
### <<<<<<<<<<<<<<<<<<<<

CM = AFFE_MATERIAU(MAILLAGE=MA, AFFE=_F(TOUT="OUI", MATER=MAT))

### >>>>>>>>>>>>>>>>>>>
### Boundary conditions
### <<<<<<<<<<<<<<<<<<<

LIAISON = AFFE_CHAR_CINE(MODELE=MO, MECA_IMPO=(_F(GROUP_MA="GAUCHE2", DX=0, DY=0, DZ=0)))

# Mode I
TRAC_1 = AFFE_CHAR_CINE(
    MODELE=MO, MECA_IMPO=(_F(GROUP_MA="DROITE", DX=cos(pi / 6), DY=sin(pi / 6), DZ=0))
)
u_1 = 1.5 * COHE / FROT * (L / E + 1 / KN)
FCT_1 = DEFI_FONCTION(NOM_PARA="INST", VALE=(0, 0, 1, u_1))

# Mode II
TRAC_2 = AFFE_CHAR_CINE(
    MODELE=MO, MECA_IMPO=(_F(GROUP_MA="CUBE", DX=-sin(pi / 6), DY=cos(pi / 6), DZ=0))
)
u_2 = 1.5 * COHE / KT
FCT_2 = DEFI_FONCTION(NOM_PARA="INST", VALE=(0, 0, 1, u_2))

# Mode III
TRAC_3 = AFFE_CHAR_CINE(MODELE=MO, MECA_IMPO=(_F(GROUP_MA="CUBE", DX=0, DY=0, DZ=1)))
u_3 = 1.5 * COHE / KT
FCT_3 = DEFI_FONCTION(NOM_PARA="INST", VALE=(0, 0, 1, u_3))

### >>>>>>>>>>
### Time steps
### <<<<<<<<<<

L_INST = DEFI_LIST_REEL(DEBUT=0, INTERVALLE=(_F(JUSQU_A=1, NOMBRE=5)))

### >>>>>>>>>>>>>>>>>>>
### Solution for mode I
### <<<<<<<<<<<<<<<<<<<

U_1 = STAT_NON_LINE(
    MODELE=MO,
    CHAM_MATER=CM,
    CARA_ELEM=ORIEN_FI,
    EXCIT=(_F(CHARGE=LIAISON), _F(CHARGE=TRAC_1, FONC_MULT=FCT_1)),
    COMPORTEMENT=(
        _F(RELATION="CZM_FROT_MIX", GROUP_MA="CUBEDEG"),
        _F(RELATION="ELAS", GROUP_MA="CUBE"),
    ),
    INCREMENT=_F(LIST_INST=L_INST),
    SOLVEUR=_F(METHODE="MUMPS"),
    CONVERGENCE=_F(
        RESI_REFE_RELA=1e-6, SIGM_REFE=COHE / FROT, DEPL_REFE=COHE / FROT / KN, ITER_GLOB_MAXI=10
    ),
    NEWTON=_F(MATRICE="TANGENTE"),
)

TEST_RESU(
    RESU=_F(
        INST=1,
        REFERENCE="ANALYTIQUE",
        POINT=1,
        RESULTAT=U_1,
        NOM_CHAM="SIEF_ELGA",
        NOM_CMP="SIGN",
        VALE_REFE=2e6,
        VALE_CALC=2e6,
        GROUP_MA="CUBEDEG",
    )
)

TEST_RESU(
    RESU=_F(
        INST=1,
        REFERENCE="ANALYTIQUE",
        POINT=1,
        RESULTAT=U_1,
        NOM_CHAM="VARI_ELGA",
        NOM_CMP="V7",
        VALE_REFE=1,
        VALE_CALC=1,
        GROUP_MA="CUBEDEG",
    )
)

### >>>>>>>>>>>>>>>>>>>>
### Solution for mode II
### <<<<<<<<<<<<<<<<<<<<

U_2 = STAT_NON_LINE(
    MODELE=MO,
    CHAM_MATER=CM,
    CARA_ELEM=ORIEN_FI,
    EXCIT=(_F(CHARGE=LIAISON), _F(CHARGE=TRAC_2, FONC_MULT=FCT_2)),
    COMPORTEMENT=(
        _F(RELATION="CZM_FROT_MIX", GROUP_MA="CUBEDEG", RESI_INTE=1e-8),
        _F(RELATION="ELAS", GROUP_MA="CUBE"),
    ),
    INCREMENT=_F(LIST_INST=L_INST),
    SOLVEUR=_F(METHODE="MUMPS"),
    CONVERGENCE=_F(RESI_REFE_RELA=1e-6, SIGM_REFE=COHE, DEPL_REFE=COHE / KT, ITER_GLOB_MAXI=10),
    NEWTON=_F(MATRICE="TANGENTE"),
)

TEST_RESU(
    RESU=_F(
        INST=1,
        REFERENCE="ANALYTIQUE",
        POINT=1,
        RESULTAT=U_2,
        NOM_CHAM="SIEF_ELGA",
        NOM_CMP="SITX",
        VALE_REFE=1e6,
        VALE_CALC=1e6,
        GROUP_MA="CUBEDEG",
    )
)

TEST_RESU(
    RESU=_F(
        INST=1,
        REFERENCE="ANALYTIQUE",
        POINT=1,
        RESULTAT=U_2,
        NOM_CHAM="VARI_ELGA",
        NOM_CMP="V6",
        VALE_REFE=1,
        VALE_CALC=1,
        GROUP_MA="CUBEDEG",
    )
)

### >>>>>>>>>>>>>>>>>>>>>
### Solution for mode III
### <<<<<<<<<<<<<<<<<<<<<

U_3 = STAT_NON_LINE(
    MODELE=MO,
    CHAM_MATER=CM,
    CARA_ELEM=ORIEN_FI,
    EXCIT=(_F(CHARGE=LIAISON), _F(CHARGE=TRAC_3, FONC_MULT=FCT_3)),
    COMPORTEMENT=(
        _F(RELATION="CZM_FROT_MIX", GROUP_MA="CUBEDEG", RESI_INTE=1e-8),
        _F(RELATION="ELAS", GROUP_MA="CUBE"),
    ),
    INCREMENT=_F(LIST_INST=L_INST),
    SOLVEUR=_F(METHODE="MUMPS"),
    CONVERGENCE=_F(RESI_REFE_RELA=1e-6, SIGM_REFE=COHE, DEPL_REFE=COHE / KT, ITER_GLOB_MAXI=10),
    NEWTON=_F(MATRICE="TANGENTE"),
)

TEST_RESU(
    RESU=_F(
        INST=1,
        REFERENCE="ANALYTIQUE",
        POINT=1,
        RESULTAT=U_3,
        NOM_CHAM="SIEF_ELGA",
        NOM_CMP="SITY",
        VALE_REFE=1e6,
        VALE_CALC=1e6,
        GROUP_MA="CUBEDEG",
    )
)

TEST_RESU(
    RESU=_F(
        INST=1,
        REFERENCE="ANALYTIQUE",
        POINT=1,
        RESULTAT=U_3,
        NOM_CHAM="VARI_ELGA",
        NOM_CMP="V6",
        VALE_REFE=1,
        VALE_CALC=1,
        GROUP_MA="CUBEDEG",
    )
)

FIN()
