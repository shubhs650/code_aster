
import sympy as sp
import itertools

# ----------------------------------------------------------------------
# Variables
# ----------------------------------------------------------------------
r, z = sp.symbols('r z', real=True)

# ----------------------------------------------------------------------
# Paramètres matériaux
# ----------------------------------------------------------------------
lam, mu = sp.symbols('lambda mu', real=True)

# exemple - solution


# Champs admissibles
ur = sp.sin( sp.pi * r)*sp.sin( sp.pi * z)
uz = sp.cos( sp.pi * r)*sp.cos( sp.pi * z)

u = sp.Matrix([ur, uz])

# ----------------------------------------------------------------------
# Déformations axisymétriques
# ----------------------------------------------------------------------

dur_dr = sp.diff(ur, r)
dur_dz = sp.diff(ur, z)

duz_dr = sp.diff(uz, r)
duz_dz = sp.diff(uz, z)

eps_rr = dur_dr
eps_zz = duz_dz
eps_rz = (dur_dz + duz_dr)/2
eps_tt = sp.simplify(ur / r)

trace_eps = sp.simplify(eps_rr + eps_zz + eps_tt)

# ----------------------------------------------------------------------
# Contraintes (Hooke isotrope)
# ----------------------------------------------------------------------

sigma_rr = 2*mu*eps_rr + lam*trace_eps
sigma_zz = 2*mu*eps_zz + lam*trace_eps
sigma_rz = 2*mu*eps_rz
sigma_tt = 2*mu*eps_tt + lam*trace_eps

# ----------------------------------------------------------------------
# Divergence axisymétrique
# ----------------------------------------------------------------------

div_r = (1/r)*sp.diff(r*sigma_rr, r) + sp.diff(sigma_rz, z) - sigma_tt / r
div_z = (1/r)*sp.diff(r*sigma_rz, r) + sp.diff(sigma_zz, z)

# second membre
f_r = sp.simplify(-div_r)
f_z = sp.simplify(-div_z)

# ----------------------------------------------------------------------
# Simplification forte (clé)
# ----------------------------------------------------------------------

f_r_poly = sp.simplify(sp.expand(f_r))
f_z_poly = sp.simplify(sp.expand(f_z))


# ----------------------------------------------------------------------
# Affichage
# ----------------------------------------------------------------------

print("\n=== u_r ===")
sp.pprint(ur)

print("\n=== u_z ===")
sp.pprint(uz)

print("\n=== lambda*div(u) ===")
sp.pprint(lam*trace_eps)

print("\n=== limite eps_tt ===")
sp.pprint(sp.limit(eps_tt, r, 0, dir='+'))

print("\n=== f_r ===")
sp.pprint(f_r_poly)

print("\n=== f_z ===")
sp.pprint(f_z_poly)
