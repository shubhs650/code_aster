DEBUT(
    CODE="OUI",
    DEBUG=_F(SDVERI="OUI"),
    IMPR_MACRO="OUI",
    IGNORE_ALARM=("MECANONLINE5_32", "MECANONLINE5_57"),
)

# Test de CALC_ENDO avec mélange de modélisation et avec options avancées
# VARC et chargement fonctions du temps
# Fonctionnalités examinées :
#  1) Vérification analytique des chargements imposés au cours du transitoire
#  2) Non régression sur les contraintes calculées au cours du transitoire
#  3) Non régression sur la table d'observation

# ----------------------------------------------------------------------
# Paramètres. Unités : mm, MPa, s
# ----------------------------------------------------------------------

UIMP = 2.0e-3  # déplacement d'allongement imposé (comme L=1 mm, la déformation vaut aussi uimp) (linéaire entre 0 et 100 s)
TIMP = 100  # élévation de température (linéaire entre 0 et 100 s)
CIMP = 50  # concentration en eau imposée (linéaire entre 0 et 100 s)
EIMP = 5.0e-4  # déformation anélastique imposée dans la direction yy (constante)

##Materiau béton
b_young = 40.2e3
b_nu = 0.19
b_rho = 2.410e-9
b_ft = 4.65
b_fc = 63.7
b_gf = 73 * b_fc**0.18 / 1000
b_p = 1.5
b_dist_fiss = 225.0

alpha = 1.0e-5
kdessic = 3.6e-6

##Viscosité et paramétrage de la stabilisation
b_tau_reguvisc = 1.0
b_coeff_rigi_regu_visc = 0.001
prec_dam = 0.1

duree_rampe = 1
duree_equil = 10
nbr_sequ_equil = 50

##Convergence
r_conv = 1e-2
r_stab = r_conv

##Matériau acier
a_young = 200e3
a_nu = 0.3
a_sy = 500
a_rho = 7.800e-9

ma_me = LIRE_MAILLAGE(INFO=2)

mo_me = AFFE_MODELE(
    MAILLAGE=ma_me,
    AFFE=(
        _F(PHENOMENE="MECANIQUE", MODELISATION="3D", GROUP_MA="massif"),
        _F(PHENOMENE="MECANIQUE", MODELISATION="DKT", GROUP_MA="coque"),
        _F(PHENOMENE="MECANIQUE", MODELISATION="GRILLE_MEMBRANE", GROUP_MA="grille"),
        _F(PHENOMENE="MECANIQUE", MODELISATION="GRILLE_EXCENTRE", GROUP_MA="grille_excentree"),
        _F(PHENOMENE="MECANIQUE", MODELISATION="BARRE", GROUP_MA="barre"),
        _F(PHENOMENE="MECANIQUE", MODELISATION="DIS_T", GROUP_MA="ressort"),
    ),
)

prop_eltc = DEFI_MATER_GC(
    ENDO_LOCA_TC=_F(
        E=b_young,
        NU=b_nu,
        FT=b_ft,
        FC=b_fc,
        SIGM_COMP_SEUIL=b_fc * 0.4,
        GF=b_gf,
        COEF_ECRO_TRAC=b_p,
        DIST_FISSURE=b_dist_fiss,
    )
)

beton = DEFI_MATERIAU(
    ELAS=_F(E=b_young, NU=b_nu, RHO=b_rho, ALPHA=alpha, K_DESSIC=kdessic),
    VISC_ELAS=_F(TAU=b_tau_reguvisc, K=b_coeff_rigi_regu_visc * b_young),
    ENDO_LOCA_TC=_F(
        FC=prop_eltc.getValueReal("ENDO_LOCA_TC", "FC"),
        SIGM_COMP_SEUIL=prop_eltc.getValueReal("ENDO_LOCA_TC", "SIGM_COMP_SEUIL"),
        FT=prop_eltc.getValueReal("ENDO_LOCA_TC", "FT"),
        ENER_TRAC_RUPT_N=prop_eltc.getValueReal("ENDO_LOCA_TC", "ENER_TRAC_RUPT_N"),
        COEF_ECRO_TRAC=prop_eltc.getValueReal("ENDO_LOCA_TC", "COEF_ECRO_TRAC"),
        TAU_REGU_VISC=b_tau_reguvisc,
    ),
)

acier = DEFI_MATERIAU(
    ELAS=_F(E=a_young, NU=a_nu, ALPHA=alpha),
    ECRO_LINE=_F(SY=a_sy, D_SIGM_EPSI=0),
    VISC_ELAS=_F(TAU=1.0, K=1.0e-6),  # Sans influence, pour tester détection TAU
)


cara_me = AFFE_CARA_ELEM(
    MODELE=mo_me,
    BARRE=_F(GROUP_MA="barre", SECTION="GENERALE", CARA="A", VALE=1.0),
    COQUE=_F(GROUP_MA="coque", EPAIS=7.0, COEF_RIGI_DRZ=0, COQUE_NCOU=1, VECTEUR=(1, 0, 0)),
    GRILLE=(
        _F(GROUP_MA="grille", SECTION=1.0, VECT_1=(0, 1, 0)),
        _F(GROUP_MA="grille_excentree", SECTION=1.0, VECT_1=(0, 1, 0), EXCENTREMENT=0.0),
    ),
    DISCRET=_F(GROUP_MA="ressort", CARA="K_T_D_N", VALE=(a_young, a_young, a_young)),
)


liaison_me = AFFE_CHAR_MECA(
    MODELE=mo_me,
    DDL_IMPO=(
        _F(GROUP_MA="massif_s", DY=0),
        _F(GROUP_MA="massif_o", DX=0),
        _F(GROUP_MA="massif_b", DZ=0),
        _F(GROUP_MA="massif_n", DY=UIMP),
        _F(GROUP_MA="coque", DRZ=0),
        _F(GROUP_MA="coque_s", DY=0, DZ=0, DRX=0),
        _F(GROUP_MA="coque_o", DX=0),
        _F(GROUP_MA="coque_n", DY=UIMP),
        _F(GROUP_MA="grille", DZ=0),
        _F(GROUP_MA="grille_s", DY=0),
        _F(GROUP_MA="grille_o", DX=0),
        _F(GROUP_MA="grille_n", DY=UIMP),
        _F(GROUP_MA="grille_e", DX=0),
        _F(GROUP_MA="grille_excentree", DZ=0, DRX=0, DRY=0, DRZ=0),
        _F(GROUP_MA="grille_excentree_s", DY=0),
        _F(GROUP_MA="grille_excentree_o", DX=0),
        _F(GROUP_MA="grille_excentree_n", DY=UIMP),
        _F(GROUP_MA="grille_excentree_e", DX=0),
        _F(GROUP_MA="barre", DZ=0, DX=0),
        _F(GROUP_NO="barre_s", DY=0),
        _F(GROUP_NO="barre_n", DY=UIMP),
        _F(GROUP_NO="ressort", DX=0, DY=UIMP, DZ=0),
    ),
    DOUBLE_LAGRANGE="NON",
)


champ_mask_0 = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="ELNO_TEMP_R",
    MODELE=mo_me,
    AFFE=(
        _F(GROUP_MA="massif", NOM_CMP="TEMP", VALE=0),
        _F(GROUP_MA="coque", NOM_CMP="TEMP", VALE=0),
        _F(GROUP_MA="grille", NOM_CMP="TEMP", VALE=0),
        _F(GROUP_MA="grille_excentree", NOM_CMP="TEMP", VALE=0),
        _F(GROUP_MA="barre", NOM_CMP="TEMP", VALE=0),
        _F(GROUP_MA="ressort", NOM_CMP="TEMP", VALE=0),
    ),
    PROL_ZERO="OUI",
)


champ_zero = CREA_CHAMP(
    OPERATION="ASSE",
    TYPE_CHAM="ELNO_TEMP_R",
    AFFE_SP=_F(CARA_ELEM=cara_me),
    MODELE=mo_me,
    ASSE=(
        _F(CHAM_GD=champ_mask_0, GROUP_MA="massif", NOM_CMP="TEMP"),
        _F(CHAM_GD=champ_mask_0, GROUP_MA="coque", NOM_CMP="TEMP"),
        _F(CHAM_GD=champ_mask_0, GROUP_MA="grille", NOM_CMP="TEMP"),
        _F(CHAM_GD=champ_mask_0, GROUP_MA="grille_excentree", NOM_CMP="TEMP"),
        _F(CHAM_GD=champ_mask_0, GROUP_MA="barre", NOM_CMP="TEMP"),
        _F(CHAM_GD=champ_mask_0, GROUP_MA="ressort", NOM_CMP="TEMP"),
    ),
    PROL_ZERO="OUI",
)


champ_chaud = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="ELNO_TEMP_R",
    AFFE_SP=_F(CARA_ELEM=cara_me),
    MODELE=mo_me,
    AFFE=(
        _F(GROUP_MA="massif", NOM_CMP="TEMP", VALE=TIMP),
        _F(GROUP_MA="coque", NOM_CMP="TEMP", VALE=TIMP),
        _F(GROUP_MA="grille", NOM_CMP="TEMP", VALE=TIMP),
        _F(GROUP_MA="grille_excentree", NOM_CMP="TEMP", VALE=TIMP),
        _F(GROUP_MA="barre", NOM_CMP="TEMP", VALE=TIMP),
        _F(GROUP_MA="ressort", NOM_CMP="TEMP", VALE=TIMP),
    ),
    PROL_ZERO="OUI",
)


evol_th_me = CREA_RESU(
    OPERATION="AFFE",
    TYPE_RESU="EVOL_THER",
    AFFE=(
        _F(NOM_CHAM="TEMP", CHAM_GD=champ_zero, INST=0, MODELE=mo_me),
        _F(NOM_CHAM="TEMP", CHAM_GD=champ_chaud, INST=100, MODELE=mo_me),
    ),
)

champ_zero_sech = CREA_CHAMP(
    OPERATION="ASSE",
    TYPE_CHAM="ELNO_TEMP_R",
    AFFE_SP=_F(CARA_ELEM=cara_me),
    MODELE=mo_me,
    ASSE=(_F(CHAM_GD=champ_mask_0, GROUP_MA="massif", NOM_CMP="SECH"),),
    PROL_ZERO="OUI",
)

champ_chaud_sech = CREA_CHAMP(
    OPERATION="AFFE",
    TYPE_CHAM="ELNO_TEMP_R",
    AFFE_SP=_F(CARA_ELEM=cara_me),
    MODELE=mo_me,
    AFFE=(_F(GROUP_MA="massif", NOM_CMP="SECH", VALE=CIMP),),
    PROL_ZERO="OUI",
)


evol_sech_me = CREA_RESU(
    OPERATION="AFFE",
    TYPE_RESU="EVOL_SECH",
    AFFE=(
        _F(NOM_CHAM="SECH", CHAM_GD=champ_zero_sech, INST=0, MODELE=mo_me),
        _F(NOM_CHAM="SECH", CHAM_GD=champ_chaud_sech, INST=100, MODELE=mo_me),
    ),
)


epsa = CREA_CHAMP(
    TYPE_CHAM="ELNO_EPSI_R",
    OPERATION="AFFE",
    MODELE=mo_me,
    AFFE=(
        _F(
            GROUP_MA="massif",
            NOM_CMP=("EPXX", "EPYY", "EPZZ", "EPXY", "EPXZ", "EPYZ"),
            VALE=(0, EIMP, 0, 0, 0, 0),
        ),
    ),
    PROL_ZERO="OUI",
)

fictif = DEFI_MATERIAU(ELAS=_F(E=0, NU=0))


mate_pur = AFFE_MATERIAU(
    MODELE=mo_me,
    AFFE=(
        _F(GROUP_MA="massif", MATER=beton),
        _F(GROUP_MA="coque", MATER=acier),
        _F(GROUP_MA="grille", MATER=acier),
        _F(GROUP_MA="grille_excentree", MATER=acier),
        _F(GROUP_MA="barre", MATER=acier),
        _F(GROUP_MA="ressort", MATER=fictif),
    ),
)


mate_me = AFFE_MATERIAU(
    MODELE=mo_me,
    CHAM_MATER=mate_pur,
    AFFE_VARC=(
        _F(NOM_VARC="TEMP", EVOL=evol_th_me, VALE_REF=0),
        _F(NOM_VARC="SECH", EVOL=evol_sech_me, VALE_REF=0),
        _F(NOM_VARC="EPSA", CHAM_GD=epsa, GROUP_MA="massif"),
    ),
)

inst_me = DEFI_LIST_REEL(VALE=(0, 25, 50, 75, 100))

inst_visc = DEFI_LIST_INST(
    DEFI_LIST=_F(
        VALE=(duree_rampe, duree_rampe + duree_equil, duree_rampe + duree_equil * nbr_sequ_equil)
    ),
    METHODE="AUTO",
    MODELE=mo_me,
    ECHEC=(
        _F(EVENEMENT="ERREUR", ACTION="DECOUPE", SUBD_PAS=3, SUBD_PAS_MINI=1e-10),
        _F(
            EVENEMENT="DELTA_GRANDEUR",
            VALE_REF=1.5 * prec_dam,
            NOM_CHAM="VARI_ELGA",
            NOM_CMP="V3",
            ACTION="DECOUPE",
            SUBD_PAS=3,
            SUBD_PAS_MINI=1e-10,
            GROUP_MA="massif",
        ),
    ),
    ADAPTATION=(
        _F(
            EVENEMENT="TOUT_INST",
            MODE_CALCUL_TPLUS="DELTA_GRANDEUR",
            VALE_REF=prec_dam,
            NOM_CHAM="VARI_ELGA",
            NOM_CMP="V3",
            GROUP_MA="massif",
        ),
        _F(EVENEMENT="TOUT_INST", MODE_CALCUL_TPLUS="FIXE", PCENT_AUGM=75),
    ),
)

fonction_charge = DEFI_FONCTION(NOM_PARA="INST", ABSCISSE=[0, 100], ORDONNEE=[0, 1])


from code_aster.Behaviours import endo_loca_tc
from code_aster.Behaviours import regu_visc_elas


def Get_Vari_By_Name(bhv, vi_name):
    """
    Return the Vxx name of an internal variable vi_name with respect to the constituive relation bhv
    """
    pos = bhv.loi.get_nom_vari().index(vi_name)
    num = pos + 1
    num_name = "V" + repr(num)
    return num_name


nbvi_dam = endo_loca_tc.loi.get_nb_vari()  # nbr de variables internes du modèle d'endommagement
nbvi_visc = (
    regu_visc_elas.loi.get_nb_vari()
)  # nbr total de variables internes en tenant compte de REGU_VISC

# Nom Vxx de la variable d'endommagement pour le contrôle du calcul
vari_dam = Get_Vari_By_Name(endo_loca_tc, "HISTTRAC")
vari_trac = Get_Vari_By_Name(endo_loca_tc, "ENDOTRAC")
vari_comp = Get_Vari_By_Name(endo_loca_tc, "ENDOCOMP")
vari_visc = Get_Vari_By_Name(endo_loca_tc, "SIGMVISC")

# Nom Vxx de la variabe interne correspondant à l'énergie visco-élastique
vari_ener_visc_elas = "V%d" % (nbvi_dam + int(Get_Vari_By_Name(regu_visc_elas, "VISCELAS")[1:]))

# Formule pour compter les points qui franchissent un endommagement de 0.5 (pour observation)
f_endo = FORMULE(NOM_PARA=(vari_trac, vari_comp), VALE="1-(1-%s)*(1-%s)" % (vari_trac, vari_comp))


# Formule pour mesurer la norme de la contrainte visco-élastique
f_sigm_visc = FORMULE(
    NOM_PARA=vari_ener_visc_elas,
    VALE="(2*k*%s)**0.5" % vari_ener_visc_elas,
    k=b_coeff_rigi_regu_visc * b_young,
)


evol_me = CALC_ENDO(
    MODELE=mo_me,
    CHAM_MATER=mate_me,
    CARA_ELEM=cara_me,
    EXCIT=_F(CHARGE=liaison_me, FONC_MULT=fonction_charge),
    COMPORTEMENT=(
        _F(GROUP_MA="massif", RELATION="ENDO_LOCA_TC", REGU_VISC="OUI"),
        _F(GROUP_MA="coque", RELATION="VMIS_ISOT_LINE", RESI_CPLAN_MAXI=r_conv / 100),
        _F(GROUP_MA="grille", RELATION="GRILLE_ISOT_LINE"),
        _F(GROUP_MA="grille_excentree", RELATION="GRILLE_ISOT_LINE"),
        _F(GROUP_MA="barre", RELATION="VMIS_ISOT_LINE"),
        _F(GROUP_MA="ressort", RELATION="ELAS"),
    ),
    INCREMENT=_F(LIST_INST=inst_me),
    NEWTON=_F(MATRICE="TANGENTE"),
    SOLVEUR=_F(ELIM_LAGR="NON"),
    CONVERGENCE=_F(RESI_REFE_RELA=r_conv, ITER_GLOB_MAXI=10),
    CONVERGENCE_REFE=(
        _F(GROUP_MA="massif", SIGM=b_ft),
        _F(GROUP_MA="coque", EFFORT=700, MOMENT=4900),
        _F(GROUP_MA=("grille", "grille_excentree"), SIGM=a_sy),
        _F(GROUP_MA=("barre", "ressort"), EFFORT=a_sy * 1.0),
    ),
    OBSERVATION=(
        _F(
            TITRE="ENDO_MOY",
            PAS_OBSE=1,
            NOM_CHAM="VARI_ELGA",
            NOM_CMP=(vari_trac, vari_comp),
            GROUP_MA="massif",
            EVAL_CMP="FORMULE",
            FORMULE=f_endo,
            EVAL_ELGA="MAX",
            EVAL_CHAM="MOY",
        ),
        _F(
            TITRE="VISCENDO",
            PAS_OBSE=1,
            NOM_CHAM="VARI_ELGA",
            NOM_CMP=vari_visc,
            GROUP_MA="massif",
            EVAL_ELGA="MAX",
            EVAL_CHAM="MAX",
        ),
        _F(
            TITRE="VISCELAS",
            PAS_OBSE=1,
            NOM_CHAM="VARI_ELGA",
            NOM_CMP=vari_ener_visc_elas,
            GROUP_MA="massif",
            EVAL_CMP="FORMULE",
            FORMULE=f_sigm_visc,
            EVAL_ELGA="MAX",
            EVAL_CHAM="MAX",
        ),
    ),
    ENDO_VISC=_F(
        LIST_INST=inst_visc,
        OBSERVATION=["VISCENDO", "VISCELAS"],
        PREC_STAB=[r_stab * b_ft] * 2,
        ARCHIVAGE=_F(PAS_ARCH=1),
        TABLE=CO("tab_obs"),
        RESULTAT=CO("d_evol"),
    ),
)

# -----------------------------------------
CALC_CHAMP(
    reuse=evol_me,
    RESULTAT=evol_me,
    DEFORMATION=("EPSI_ELGA", "EPSI_ELNO"),
    VARI_INTERNE=("VARC_ELGA", "VARC_ELNO"),
    GROUP_MA=("massif", "grille", "grille_excentree", "coque"),
)

CALC_CHAMP(
    reuse=d_evol["VISC_4"],
    RESULTAT=d_evol["VISC_4"],
    DEFORMATION=("EPSI_ELGA", "EPSI_ELNO"),
    VARI_INTERNE=("VARC_ELGA", "VARC_ELNO"),
    GROUP_MA=("massif", "grille", "grille_excentree", "coque"),
)


IMPR_RESU(
    UNITE=6,
    FORMAT="RESULTAT",
    RESU=(_F(RESULTAT=evol_me, NOM_CHAM=("VARC_ELGA", "EPSI_ELGA", "SIEF_ELGA")),),
)

##################################################################################
##                  Tests analytiques sur les chargements appliqués
##################################################################################


# Test des variables de commandes TEMP et SECH variables
# Instants physiques
TEST_RESU(
    RESU=(
        _F(
            REFERENCE="ANALYTIQUE",
            INST=25,
            RESULTAT=evol_me,
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="TEMP",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=0.25 * TIMP,
            VALE_CALC=0.25 * TIMP,
            CRITERE="RELATIF",
        ),
        _F(
            REFERENCE="ANALYTIQUE",
            INST=50,
            RESULTAT=evol_me,
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="TEMP",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=0.5 * TIMP,
            VALE_CALC=0.5 * TIMP,
            CRITERE="RELATIF",
        ),
        _F(
            REFERENCE="ANALYTIQUE",
            INST=75,
            RESULTAT=evol_me,
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="TEMP",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=0.75 * TIMP,
            VALE_CALC=0.75 * TIMP,
            CRITERE="RELATIF",
        ),
        _F(
            REFERENCE="ANALYTIQUE",
            INST=100,
            RESULTAT=evol_me,
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="TEMP",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=1.0 * TIMP,
            VALE_CALC=1.0 * TIMP,
            CRITERE="RELATIF",
        ),
        _F(
            REFERENCE="ANALYTIQUE",
            INST=25,
            RESULTAT=evol_me,
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="SECH",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=0.25 * CIMP,
            VALE_CALC=0.25 * CIMP,
            CRITERE="RELATIF",
        ),
        _F(
            REFERENCE="ANALYTIQUE",
            INST=50,
            RESULTAT=evol_me,
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="SECH",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=0.5 * CIMP,
            VALE_CALC=0.5 * CIMP,
            CRITERE="RELATIF",
        ),
        _F(
            REFERENCE="ANALYTIQUE",
            INST=75,
            RESULTAT=evol_me,
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="SECH",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=0.75 * CIMP,
            VALE_CALC=0.75 * CIMP,
            CRITERE="RELATIF",
        ),
        _F(
            REFERENCE="ANALYTIQUE",
            INST=100,
            RESULTAT=evol_me,
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="SECH",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=1.0 * CIMP,
            VALE_CALC=1.0 * CIMP,
            CRITERE="RELATIF",
        ),
    )
)

# Instants fictifs sequence de chargement 75 à 100
TEST_RESU(
    RESU=(
        _F(
            REFERENCE="ANALYTIQUE",
            INST=-duree_rampe,
            RESULTAT=d_evol["VISC_4"],
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="TEMP",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=0.75 * TIMP,
            VALE_CALC=0.75 * TIMP,
            CRITERE="RELATIF",
        ),
        _F(
            REFERENCE="ANALYTIQUE",
            INST=0,
            RESULTAT=d_evol["VISC_4"],
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="TEMP",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=TIMP,
            VALE_CALC=TIMP,
            CRITERE="RELATIF",
        ),
        _F(
            REFERENCE="ANALYTIQUE",
            INST=d_evol["VISC_4"].getAccessParameters()["INST"][-1],
            RESULTAT=d_evol["VISC_4"],
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="TEMP",
            GROUP_MA="massif",
            POINT=1,
            VALE_REFE=TIMP,
            VALE_CALC=TIMP,
            CRITERE="RELATIF",
        ),
        _F(
            REFERENCE="ANALYTIQUE",
            INST=-duree_rampe,
            RESULTAT=d_evol["VISC_4"],
            NOM_CHAM="VARC_ELGA",
            NOM_CMP="SECH",
