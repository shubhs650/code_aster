#       PLAQUE RECTANGULAIRE FINIE SOUMISE A L'ACTION D'UNE TRACTION
#       THETA = 45 DEGRES

DEBUT(CODE="OUI", ERREUR=_F(ALARME="EXCEPTION"))

#
MA = LIRE_MAILLAGE(VERI_MAIL=_F(VERIF="OUI"), FORMAT="MED")

MO = AFFE_MODELE(MAILLAGE=MA, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="C_PLAN"))

#
MAT1 = DEFI_MATERIAU(ELAS=_F(E=2.0e12, NU=0.3, RHO=0.0, ALPHA=0.0))

MAT2 = DEFI_MATERIAU(ELAS=_F(E=2.0e11, NU=0.3, RHO=0.0, ALPHA=0.0))


CHMAT = AFFE_MATERIAU(
    MAILLAGE=MA,
    AFFE=(
        _F(TOUT="OUI", MATER=MAT1),
        _F(GROUP_MA="VTOT1", MATER=MAT1),
        _F(GROUP_MA="LP3P4", MATER=MAT1),
        _F(GROUP_MA="LP2P3", MATER=MAT1),
        _F(GROUP_MA="LEVR_SUP", MATER=MAT1),
        _F(GROUP_MA="VTOT2", MATER=MAT2),
        _F(GROUP_MA="LP7P8", MATER=MAT2),
        _F(GROUP_MA="LP6P7", MATER=MAT2),
        _F(GROUP_MA="LEVR_INF", MATER=MAT2),
    ),
)

#
#
MA = DEFI_GROUP(
    reuse=MA, MAILLAGE=MA, CREA_GROUP_NO=_F(GROUP_MA=("LP3P4", "LP2P3", "LP6P7", "LP7P8"))
)

#
CH = AFFE_CHAR_MECA(
    MODELE=MO,
    DDL_IMPO=(
        _F(GROUP_NO="LP6P7", DY=0.0),
        _F(GROUP_NO="LP7P8", DY=0.0),
        _F(GROUP_NO="P6", DX=0.0),
    ),
    FORCE_CONTOUR=(_F(GROUP_MA="LP3P4", FY=100.0e6), _F(GROUP_MA="LP2P3", FY=100.0e6)),
)

#
CHAMDEPL = MECA_STATIQUE(MODELE=MO, CHAM_MATER=CHMAT, EXCIT=_F(CHARGE=CH))

#
# POINT DROIT
#

FOND1 = DEFI_FOND_FISS(
    MAILLAGE=MA,
    SYME="NON",
    FOND_FISS=_F(GROUP_NO="P0"),
    LEVRE_SUP=_F(GROUP_MA="LEVR_SUP"),
    LEVRE_INF=_F(GROUP_MA="LEVR_INF"),
)

#
G01A = CALC_G(RESULTAT=CHAMDEPL, THETA=_F(R_INF=0.0, FISSURE=FOND1, R_SUP=0.001875e-2), OPTION="G")

#

TEST_TABLE(
    REFERENCE="ANALYTIQUE",
    PRECISION=0.050000000000000003,
    VALE_CALC=57.0391830852,
    VALE_REFE=59.412239999999997,
    NOM_PARA="G",
    TABLE=G01A,
)


#
G01B = CALC_G(
    RESULTAT=CHAMDEPL, THETA=_F(R_INF=0.001875e-2, FISSURE=FOND1, R_SUP=0.003750e-2), OPTION="G"
)

#

TEST_TABLE(
    REFERENCE="ANALYTIQUE",
    PRECISION=5.0000000000000001e-3,
    VALE_CALC=59.5053220995,
    VALE_REFE=59.412239999999997,
    NOM_PARA="G",
    TABLE=G01B,
)


#
G01C = CALC_G(
    RESULTAT=CHAMDEPL, THETA=_F(R_INF=0.003750e-2, FISSURE=FOND1, R_SUP=0.005625e-2), OPTION="G"
)

#

TEST_TABLE(
    REFERENCE="ANALYTIQUE",
    PRECISION=5.0000000000000001e-3,
    VALE_CALC=59.5162161435,
    VALE_REFE=59.412239999999997,
    NOM_PARA="G",
    TABLE=G01C,
)

#
G01D = CALC_G(
    RESULTAT=CHAMDEPL, THETA=_F(R_INF=0.005625e-2, FISSURE=FOND1, R_SUP=0.007500e-2), OPTION="G"
)

#

TEST_TABLE(
    REFERENCE="ANALYTIQUE",
    PRECISION=1.0e-2,
    VALE_CALC=59.5187559739,
    VALE_REFE=59.412239999999997,
    NOM_PARA="G",
    TABLE=G01D,
)

#
# POINT GAUCHE
#
FOND2 = DEFI_FOND_FISS(
    MAILLAGE=MA,
    SYME="NON",
    FOND_FISS=_F(GROUP_NO="P0G"),
    LEVRE_SUP=_F(GROUP_MA="LEVR_SUP"),
    LEVRE_INF=_F(GROUP_MA="LEVR_INF"),
)

#
G02A = CALC_G(RESULTAT=CHAMDEPL, THETA=_F(R_INF=0.0, FISSURE=FOND2, R_SUP=0.001875e-2), OPTION="G")

#

TEST_TABLE(
    REFERENCE="ANALYTIQUE",
    PRECISION=0.050000000000000003,
    VALE_CALC=54.8159180326,
    VALE_REFE=57.382620000000003,
    NOM_PARA="G",
    TABLE=G02A,
)


#
G02B = CALC_G(
    RESULTAT=CHAMDEPL, THETA=_F(R_INF=0.001875e-2, FISSURE=FOND2, R_SUP=0.003750e-2), OPTION="G"
)

#

TEST_TABLE(
    REFERENCE="ANALYTIQUE",
    PRECISION=5.0000000000000001e-3,
    VALE_CALC=57.16857198,
    VALE_REFE=57.382620000000003,
    NOM_PARA="G",
    TABLE=G02B,
)


#
G02C = CALC_G(
    RESULTAT=CHAMDEPL, THETA=_F(R_INF=0.003750e-2, FISSURE=FOND2, R_SUP=0.005625e-2), OPTION="G"
)

#

TEST_TABLE(
    REFERENCE="ANALYTIQUE",
    PRECISION=5.0000000000000001e-3,
    VALE_CALC=57.1863575951,
    VALE_REFE=57.382620000000003,
    NOM_PARA="G",
    TABLE=G02C,
)


#
G02D = CALC_G(
    RESULTAT=CHAMDEPL, THETA=_F(R_INF=0.005625e-2, FISSURE=FOND2, R_SUP=0.007500e-2), OPTION="G"
)

#

TEST_TABLE(
    REFERENCE="ANALYTIQUE",
    PRECISION=5.0000000000000001e-3,
    VALE_CALC=57.1890219611,
    VALE_REFE=57.382620000000003,
    NOM_PARA="G",
    TABLE=G02D,
)

FIN()
