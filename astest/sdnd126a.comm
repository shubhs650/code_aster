# for i, tt in enumerate(t):
#     print(tt, dx[i], dy[i], dz[i], drx[i], dry[i], drz[i])

# Référence DYNA_NON_LINE

TEST_TABLE(
    REFERENCE="AUTRE_ASTER",
    VALE_REFE=0.556819044423893,
    VALE_CALC=0.5533313636189047,
    PRECISION=0.007,
    NOM_PARA="DX",
    TABLE=TAB,
    FILTRE=_F(NOM_PARA="INST", VALE=0.2),
)

