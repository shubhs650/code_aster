# dz = TAB.EXTR_TABLE().values()["DZ"]
# drx = TAB.EXTR_TABLE().values()["DRX"]
# dry = TAB.EXTR_TABLE().values()["DRY"]
# drz = TAB.EXTR_TABLE().values()["DRZ"]

